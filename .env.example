# AmiExpress Web Environment Variables
# Copy this file to .env.local and fill in your actual values
# .env.local is ignored by git and Vercel

# ============================================
# VERCEL DEPLOYMENT (Main Application)
# ============================================

# Vercel CLI Authentication
# Get from: vercel login (or copy from ~/.vercel/auth.json)
VERCEL_TOKEN=vercel_token_here

# ============================================
# RENDER.COM DEPLOYMENT (Webhooks)
# ============================================

# Render API Key
# Get from: https://dashboard.render.com/account/api-keys
RENDER_API_KEY=render_api_key_here

# ============================================
# DATABASE CONFIGURATION (SQLite)
# ============================================

# SQLite database directory (defaults to ./data if not set)
DATABASE_DIR=./data

# SQLite database filename (defaults to amiexpress.db if not set)
DATABASE_FILE=amiexpress.db

# Full SQLite database path (alternative to separate dir/file)
# DATABASE_URL=./data/amiexpress.db

# ============================================
# APPLICATION CONFIGURATION
# ============================================

# JWT Secret for authentication
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here

# Node Environment
NODE_ENV=production

# ============================================
# VERCEL-SPECIFIC VARIABLES
# ============================================

# Vercel Project ID (optional, for API calls)
# Get from: vercel project ls
VERCEL_PROJECT_ID=your_project_id

# Vercel Organization ID (optional, for team deployments)
# Get from: vercel teams ls
VERCEL_ORG_ID=your_org_id

# ============================================
# DEPLOYMENT NOTIFICATIONS (Optional)
# ============================================

# Deployment Webhook URL (Discord or Slack)
# Get from: Discord (Server Settings > Integrations > Webhooks)
#           Slack (Incoming Webhooks app)
# Leave empty to disable deployment notifications
DEPLOY_WEBHOOK_URL=

# Example Discord:
# DEPLOY_WEBHOOK_URL=https://discord.com/api/webhooks/1234567890/abcdefghijklmnop

# Example Slack:
# DEPLOY_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXX

# ============================================
# DEVELOPMENT VARIABLES (Optional)
# ============================================

# Development database location
# DATABASE_DIR=./data
# DATABASE_FILE=amiexpress-dev.db

# Development server ports
BACKEND_PORT=3001
FRONTEND_PORT=5173