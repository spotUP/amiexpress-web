{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "postinstall": "node ./scripts/build-web-assets.cjs",
    "dev": "npx tsx src/index.ts",
    "build": "npm install && npx tsc --project tsconfig.build.json",
    "build:dev": "npm install",
    "start": "npx tsx src/index.ts",
    "start:dev": "npx tsx src/index.ts",
    "render-start": "npx tsx src/index.ts",
    "test": "jest --config dev-scripts/jest.config.ts --rootDir .",
    "test:watch": "jest --config dev-scripts/jest.config.ts --rootDir . --watch",
    "test:coverage": "jest --config dev-scripts/jest.config.ts --rootDir . --coverage",
    "test:corpus": "jest --config dev-scripts/jest.config.ts --rootDir . --testPathPattern=corpus",
    "corpus": "cd ../.. && npx tsx dev/scripts/door-corpus/run.ts",
    "corpus:capture": "cd ../.. && npx tsx dev/scripts/door-corpus/run.ts --capture",
    "corpus:integration": "npx tsx src/scripts/corpus-integration-runner.ts --concurrency 1",
    "corpus:integration:capture": "npx tsx src/scripts/corpus-integration-runner.ts --concurrency 1 --capture",
    "corpus:integration:smoke": "npx tsx src/scripts/corpus-integration-runner.ts --concurrency 1 --only \"$(tr '\\n' ',' < ../../dev/scripts/door-corpus/integration-smoke.txt | sed 's/,$//')\"",
    "probe": "cd ../.. && npx tsx dev/scripts/door-probe/probe.ts",
    "coverage:report": "cd ../.. && npx tsx dev/scripts/door-probe/coverage-report.ts",
    "clusters:report": "cd ../.. && npx tsx dev/scripts/door-probe/timeout-clusters.ts",
    "corpus:integration:per-door": "bash ../../dev/scripts/door-corpus/per-door-test.sh --list ../../dev/scripts/door-corpus/integration-smoke-isolated.txt",
    "corpus:integration:all": "bash ../../dev/scripts/door-corpus/per-door-test.sh -j 1 --list ../../dev/scripts/door-corpus/integration-smoke-all.txt",
    "corpus:integration:ci": "bash ../../dev/scripts/door-corpus/per-door-test.sh -j 2 --retry 1 --list ../../dev/scripts/door-corpus/integration-smoke-all.txt"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@amiexpress/bbs-door-sdk": "file:../../sdk",
    "@types/nodemailer": "^7.0.4",
    "adm-zip": "^0.5.16",
    "axios": "^1.12.2",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "deasync": "^0.1.31",
    "dotenv": "^17.2.3",
    "esbuild": "^0.27.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "iconv-lite": "^0.6.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-pty": "^1.1.0",
    "nodemailer": "^7.0.12",
    "pako": "^2.1.0",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.1",
    "ssh2": "^1.17.0",
    "tar-stream": "^3.1.7",
    "tsx": "^4.19.2",
    "tsyringe": "^4.10.0",
    "typescript": "^5.9.3",
    "uuid": "^13.0.0",
    "web-push": "^3.6.7",
    "zmodem.js": "^0.1.10",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@swc/core": "^1.15.30",
    "@swc/jest": "^0.2.39",
    "@types/adm-zip": "^0.5.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/body-parser": "^1.19.6",
    "@types/busboy": "^1.5.4",
    "@types/cors": "^2.8.19",
    "@types/deasync": "^0.1.5",
    "@types/express": "^5.0.5",
    "@types/express-serve-static-core": "^5.1.0",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/serve-static": "^2.2.0",
    "@types/ssh2": "^1.15.5",
    "@types/supertest": "^6.0.2",
    "@types/tar-stream": "^3.1.4",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2"
  }
}
