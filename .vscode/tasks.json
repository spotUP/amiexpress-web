{
  "version": "2.0.0",
  "tasks": [
    // ========================================
    // SDK Build Tasks
    // ========================================
    {
      "label": "🔨 Build SDK",
      "type": "npm",
      "script": "build",
      "path": "sdk/",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "👀 Watch SDK",
      "type": "npm",
      "script": "dev",
      "path": "sdk/",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc-watch",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting compilation",
          "endsPattern": "(Compilation complete|Found \\d+ errors)"
        }
      }
    },

    // ========================================
    // Backend Build Tasks
    // ========================================
    {
      "label": "🔨 Build Backend",
      "type": "shell",
      "command": "npx tsc --noEmit",
      "options": {
        "cwd": "${workspaceFolder}/web/backend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "🔨 Build Frontend",
      "type": "npm",
      "script": "build",
      "path": "web/frontend/",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": ["$tsc"]
    },

    // ========================================
    // Server Management
    // ========================================
    {
      "label": "🚀 Start All Servers",
      "type": "shell",
      "command": "./dev/scripts/start-servers.sh",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "🛑 Kill All Servers",
      "type": "shell",
      "command": "./dev/scripts/kill-servers.sh",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },

    // ========================================
    // Testing Tasks
    // ========================================
    {
      "label": "🧪 Test Backend",
      "type": "npm",
      "script": "test",
      "path": "web/backend/",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "🧪 Test SDK",
      "type": "npm",
      "script": "test",
      "path": "sdk/",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "🧪 Test All Commands",
      "type": "shell",
      "command": "node dev/scripts/test-all-commands.js",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },

    // ========================================
    // SDK Preview Server
    // ========================================
    {
      "label": "🎮 Start SDK Preview",
      "type": "npm",
      "script": "preview",
      "path": "sdk/",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "^$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting preview server",
          "endsPattern": "Preview server running"
        }
      }
    },

    // ========================================
    // Git & Deployment
    // ========================================
    {
      "label": "🚀 Push and Deploy",
      "type": "shell",
      "command": "./dev/scripts/push-and-deploy.sh",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
