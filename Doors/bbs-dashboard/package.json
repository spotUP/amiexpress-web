{
  "name": "bbs-dashboard",
  "version": "2.0.0",
  "description": "BBS SysOp Dashboard - Real-time monitoring using SDK v2.0 and neo-blessed UI",
  "main": "dist/index.js",
  "bbsCommand": "DASHBOARD",
  "doorType": "TS",
  "runtime": "server",
  "doorPattern": "runDoor",
  "accessLevel": 0,
  "scripts": {
    "build": "tsc",
    "dev": "tsx --watch index.ts",
    "start": "node compiled/index.js"
  },
  "keywords": ["bbs", "dashboard", "sysop", "monitoring"],
  "author": "AmiExpress SDK",
  "license": "MIT",
  "dependencies": {
    "@amiexpress/bbs-door-sdk": "file:../../sdk",
    "neo-blessed": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0"
  }
}
