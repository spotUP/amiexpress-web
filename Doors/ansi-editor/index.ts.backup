/**
 * ANSI Screen Editor Door
 * A full-featured ANSI/ASCII editor for creating BBS screen files
 *
 * Features:
 * - Draw with ANSI colors (0-7 foreground/background)
 * - Line drawing tools
 * - Text entry mode
 * - Load existing screen files
 * - Save to BBS Screens/ directory
 * - Canvas: 80x24 (standard BBS dimensions)
 */

import { Socket } from 'socket.io';
import * as fs from 'fs';
import * as path from 'path';

interface DoorSession {
  socket: Socket;
  user: any;
  bbsSession?: any;  // Reference to the BBS session object
}

interface Cell {
  char: string;
  fg: number;  // 0-7
  bg: number;  // 0-7
}

type Tool = 'draw' | 'line' | 'box' | 'text' | 'fill' | 'pick';

class ANSIEditor {
  private socket: Socket;
  private user: any;
  private canvas: Cell[][] = [];
  private width = 80;
  private height = 24;

  // Cursor state
  private cursorX = 0;
  private cursorY = 0;

  // Drawing state
  private currentFg = 7;  // White
  private currentBg = 0;  // Black
  private currentChar = ' ';
  private currentTool: Tool = 'draw';

  // Tool state
  private lineStart: { x: number; y: number } | null = null;
  private textMode = false;
  private textBuffer = '';

  // File state
  private filename: string | null = null;
  private modified = false;

  // Selection state
  private selecting = false;
  private selectionStart: { x: number; y: number } | null = null;
  private selectionEnd: { x: number; y: number } | null = null;

  // Insert mode
  private insertMode = true;

  // Undo stack (simple - stores full canvas snapshots)
  private undoStack: Cell[][][] = [];
  private redoStack: Cell[][][] = [];

  // Door session reference
  private doorSession: DoorSession;

  constructor(session: DoorSession) {
    this.socket = session.socket;
    this.user = session.user;
    this.doorSession = session;
    this.initCanvas();
  }

  private initCanvas(): void {
    // Initialize with blank cells
    for (let y = 0; y < this.height; y++) {
      this.canvas[y] = [];
      for (let x = 0; x < this.width; x++) {
        this.canvas[y][x] = { char: ' ', fg: 7, bg: 0 };
      }
    }
  }

  private emit(data: string): void {
    this.socket.emit('ansi-output', data);
  }

  private clearScreen(): void {
    this.emit('\x1b[2J\x1b[H');
  }

  private moveCursor(x: number, y: number): void {
    this.emit(`\x1b[${y + 1};${x + 1}H`);
  }

  private setColors(fg: number, bg: number): void {
    this.emit(`\x1b[0;3${fg};4${bg}m`);
  }

  private showStatusBar(): void {
    // Status bar at bottom (line 24)
    this.moveCursor(0, 23);
    this.setColors(0, 7);  // Black on white

    const toolName = this.currentTool.toUpperCase().padEnd(6);
    const pos = `X:${this.cursorX.toString().padStart(2)}  Y:${this.cursorY.toString().padStart(2)}`;
    const colors = `FG:${this.currentFg} BG:${this.currentBg}`;
    const char = `CH:'${this.currentChar}'`;
    const file = this.filename || 'UNSAVED';
    const mod = this.modified ? '*' : ' ';

    const status = `${mod}${toolName} ${pos} ${colors} ${char} [${file}]`.padEnd(80);
    this.emit(status);

    this.setColors(this.currentFg, this.currentBg);
  }

  private showHelpLine(): void {
    // Help line at line 23
    this.moveCursor(0, 22);
    this.setColors(7, 1);  // White on blue

    let help = '';
    switch (this.currentTool) {
      case 'draw':
        help = 'ARROWS=Move  SPACE=Draw  F1-F8=Color  TAB=Tool  S=Save  L=Load  Q=Quit';
        break;
      case 'line':
        help = 'Click start, move, click end to draw line  TAB=Tool  Q=Quit';
        break;
      case 'box':
        help = 'Click corner, move, click corner to draw box  TAB=Tool  Q=Quit';
        break;
      case 'text':
        help = 'Type text, ENTER to place  ESC=Cancel  TAB=Tool  Q=Quit';
        break;
      case 'fill':
        help = 'Click to flood-fill area  TAB=Tool  Q=Quit';
        break;
      case 'pick':
        help = 'Click cell to pick color/char  TAB=Tool  Q=Quit';
        break;
    }

    this.emit(help.padEnd(80).substring(0, 80));
    this.setColors(this.currentFg, this.currentBg);
  }

  private renderCanvas(): void {
    // Render canvas area (lines 1-22)
    for (let y = 0; y < 22; y++) {
      this.moveCursor(0, y);
      for (let x = 0; x < this.width; x++) {
        const cell = this.canvas[y][x];
        this.setColors(cell.fg, cell.bg);
        this.emit(cell.char);
      }
    }
  }

  private renderCursor(): void {
    // Show cursor at current position
    this.moveCursor(this.cursorX, this.cursorY);
    const cell = this.canvas[this.cursorY][this.cursorX];
    this.setColors(cell.bg, cell.fg);  // Invert colors
    this.emit(cell.char);
    this.setColors(this.currentFg, this.currentBg);
  }

  private refresh(): void {
    this.clearScreen();
    this.renderCanvas();
    this.showHelpLine();
    this.showStatusBar();
    this.renderCursor();
  }

  private drawCell(x: number, y: number): void {
    if (x < 0 || x >= this.width || y < 0 || y >= 22) return;

    this.canvas[y][x] = {
      char: this.currentChar,
      fg: this.currentFg,
      bg: this.currentBg
    };

    this.moveCursor(x, y);
    this.setColors(this.currentFg, this.currentBg);
    this.emit(this.currentChar);
    this.modified = true;
  }

  private drawLine(x1: number, y1: number, x2: number, y2: number): void {
    // Bresenham's line algorithm
    const dx = Math.abs(x2 - x1);
    const dy = Math.abs(y2 - y1);
    const sx = x1 < x2 ? 1 : -1;
    const sy = y1 < y2 ? 1 : -1;
    let err = dx - dy;

    let x = x1;
    let y = y1;

    while (true) {
      this.drawCell(x, y);

      if (x === x2 && y === y2) break;

      const e2 = 2 * err;
      if (e2 > -dy) {
        err -= dy;
        x += sx;
      }
      if (e2 < dx) {
        err += dx;
        y += sy;
      }
    }
  }

  private drawBox(x1: number, y1: number, x2: number, y2: number): void {
    const left = Math.min(x1, x2);
    const right = Math.max(x1, x2);
    const top = Math.min(y1, y2);
    const bottom = Math.max(y1, y2);

    // Top and bottom
    for (let x = left; x <= right; x++) {
      this.drawCell(x, top);
      this.drawCell(x, bottom);
    }

    // Left and right
    for (let y = top; y <= bottom; y++) {
      this.drawCell(left, y);
      this.drawCell(right, y);
    }
  }

  private floodFill(x: number, y: number): void {
    if (x < 0 || x >= this.width || y < 0 || y >= 22) return;

    const targetCell = this.canvas[y][x];
    const target = `${targetCell.char}:${targetCell.fg}:${targetCell.bg}`;
    const replacement = `${this.currentChar}:${this.currentFg}:${this.currentBg}`;

    if (target === replacement) return;

    const stack: Array<{x: number, y: number}> = [{x, y}];
    const visited = new Set<string>();

    while (stack.length > 0) {
      const pos = stack.pop()!;
      const key = `${pos.x},${pos.y}`;

      if (visited.has(key)) continue;
      if (pos.x < 0 || pos.x >= this.width || pos.y < 0 || pos.y >= 22) continue;

      const cell = this.canvas[pos.y][pos.x];
      const current = `${cell.char}:${cell.fg}:${cell.bg}`;

      if (current !== target) continue;

      visited.add(key);
      this.drawCell(pos.x, pos.y);

      // Add neighbors
      stack.push({x: pos.x + 1, y: pos.y});
      stack.push({x: pos.x - 1, y: pos.y});
      stack.push({x: pos.x, y: pos.y + 1});
      stack.push({x: pos.x, y: pos.y - 1});
    }
  }

  private pickCell(x: number, y: number): void {
    if (x < 0 || x >= this.width || y < 0 || y >= 22) return;

    const cell = this.canvas[y][x];
    this.currentChar = cell.char;
    this.currentFg = cell.fg;
    this.currentBg = cell.bg;

    this.showStatusBar();
  }

  private async saveFile(): Promise<boolean> {
    this.emit('\r\n\r\nFilename to save (no path): ');

    const filename = await this.getInput();
    if (!filename || filename.length === 0) {
      this.emit('\x1b[31mSave cancelled.\x1b[0m\r\n');
      return false;
    }

    // Save to BBS Screens directory
    const dataDir = process.env.DATA_DIR || path.join(__dirname, '../../backend/data/bbs');
    const screensDir = path.join(dataDir, 'BBS', 'Screens');

    if (!fs.existsSync(screensDir)) {
      fs.mkdirSync(screensDir, { recursive: true });
    }

    const filepath = path.join(screensDir, filename);

    try {
      // Convert canvas to ANSI
      let ansi = '';
      let lastFg = -1;
      let lastBg = -1;

      for (let y = 0; y < 22; y++) {
        for (let x = 0; x < this.width; x++) {
          const cell = this.canvas[y][x];

          // Only emit color codes when colors change
          if (cell.fg !== lastFg || cell.bg !== lastBg) {
            ansi += `\x1b[0;3${cell.fg};4${cell.bg}m`;
            lastFg = cell.fg;
            lastBg = cell.bg;
          }

          ansi += cell.char;
        }
        ansi += '\r\n';
      }

      ansi += '\x1b[0m';  // Reset at end

      fs.writeFileSync(filepath, ansi, 'utf8');

      this.filename = filename;
      this.modified = false;

      this.emit(`\x1b[32mSaved: ${filename}\x1b[0m\r\n`);
      await this.sleep(1000);
      return true;

    } catch (error) {
      this.emit(`\x1b[31mError saving: ${error}\x1b[0m\r\n`);
      await this.sleep(2000);
      return false;
    }
  }

  private async loadFile(): Promise<boolean> {
    this.emit('\r\n\r\nFilename to load (no path): ');

    const filename = await this.getInput();
    if (!filename || filename.length === 0) {
      this.emit('\x1b[31mLoad cancelled.\x1b[0m\r\n');
      return false;
    }

    const dataDir = process.env.DATA_DIR || path.join(__dirname, '../../backend/data/bbs');
    const filepath = path.join(dataDir, 'BBS', 'Screens', filename);

    if (!fs.existsSync(filepath)) {
      this.emit(`\x1b[31mFile not found: ${filename}\x1b[0m\r\n`);
      await this.sleep(2000);
      return false;
    }

    try {
      const content = fs.readFileSync(filepath, 'utf8');
      this.parseANSI(content);

      this.filename = filename;
      this.modified = false;

      this.emit(`\x1b[32mLoaded: ${filename}\x1b[0m\r\n`);
      await this.sleep(1000);
      return true;

    } catch (error) {
      this.emit(`\x1b[31mError loading: ${error}\x1b[0m\r\n`);
      await this.sleep(2000);
      return false;
    }
  }

  private parseANSI(ansi: string): void {
    // Simple ANSI parser - converts ANSI to canvas
    // This is a basic implementation, may need enhancement

    this.initCanvas();  // Clear canvas

    let x = 0;
    let y = 0;
    let fg = 7;
    let bg = 0;
    let i = 0;

    while (i < ansi.length && y < 22) {
      const ch = ansi[i];

      if (ch === '\x1b') {
        // ANSI escape sequence
        const escStart = i;
        i++;

        if (ansi[i] === '[') {
          i++;
          let params = '';

          while (i < ansi.length && ansi[i] !== 'm' && ansi[i] !== 'H' && ansi[i] !== 'J') {
            params += ansi[i];
            i++;
          }

          const cmd = ansi[i];
          i++;

          if (cmd === 'm') {
            // Color codes
            const codes = params.split(';').map(c => parseInt(c) || 0);
            for (const code of codes) {
              if (code === 0) {
                fg = 7;
                bg = 0;
              } else if (code >= 30 && code <= 37) {
                fg = code - 30;
              } else if (code >= 40 && code <= 47) {
                bg = code - 40;
              }
            }
          } else if (cmd === 'H' || cmd === 'J') {
            // Ignore cursor positioning for now
          }
        }
      } else if (ch === '\r') {
        x = 0;
        i++;
      } else if (ch === '\n') {
        y++;
        i++;
      } else {
        // Regular character
        if (x < this.width && y < 22) {
          this.canvas[y][x] = { char: ch, fg, bg };
          x++;
        }
        i++;
      }
    }
  }

  private async getInput(): Promise<string> {
    return new Promise((resolve) => {
      let buffer = '';

      const handler = (input: string) => {
        buffer += input;

        // Check for Enter
        if (input === '\r' || input === '\n') {
          if (this.doorSession.bbsSession) {
            this.doorSession.bbsSession.doorInputHandler = null;
          }
          resolve(buffer.replace(/[\r\n]/g, ''));
        }
        // Check for backspace
        else if (input === '\x7f' || input === '\x08') {
          if (buffer.length > 0) {
            buffer = buffer.slice(0, -1);
            this.emit('\x08 \x08');
          }
        }
        // Echo character
        else {
          this.emit(input);
        }
      };

      // Register input handler on BBS session
      if (this.doorSession.bbsSession) {
        this.doorSession.bbsSession.doorInputHandler = handler;
      }
    });
  }

  private sleep(ms: number): Promise<void> {
    return new Promise(resolve => setTimeout(resolve, ms));
  }

  async run(): Promise<void> {
    this.clearScreen();
    this.refresh();

    return new Promise((resolve) => {
      const handler = async (input: string) => {
        const key = input;

        // Text mode handling
        if (this.textMode && this.currentTool === 'text') {
          if (key === '\x1b') {  // ESC
            this.textMode = false;
            this.textBuffer = '';
            this.refresh();
          } else if (key === '\r' || key === '\n') {  // ENTER
            // Place text
            for (let i = 0; i < this.textBuffer.length; i++) {
              this.currentChar = this.textBuffer[i];
              this.drawCell(this.cursorX + i, this.cursorY);
            }
            this.textMode = false;
            this.textBuffer = '';
            this.currentChar = ' ';
            this.refresh();
          } else if (key === '\x7f' || key === '\x08') {  // BACKSPACE
            if (this.textBuffer.length > 0) {
              this.textBuffer = this.textBuffer.slice(0, -1);
            }
          } else if (key.length === 1 && key.charCodeAt(0) >= 32 && key.charCodeAt(0) <= 126) {
            this.textBuffer += key;
          }

          // Show text buffer in status
          this.showStatusBar();
          return;
        }

        // Normal key handling
        switch (key) {
          // Arrow keys
          case '\x1b[A':  // Up
            this.cursorY = Math.max(0, this.cursorY - 1);
            this.refresh();
            break;
          case '\x1b[B':  // Down
            this.cursorY = Math.min(21, this.cursorY + 1);
            this.refresh();
            break;
          case '\x1b[C':  // Right
            this.cursorX = Math.min(this.width - 1, this.cursorX + 1);
            this.refresh();
            break;
          case '\x1b[D':  // Left
            this.cursorX = Math.max(0, this.cursorX - 1);
            this.refresh();
            break;

          // Function keys (F1-F8 for colors)
          case '\x1bOP':  // F1 - Black
            this.currentFg = 0;
            this.showStatusBar();
            break;
          case '\x1bOQ':  // F2 - Red
            this.currentFg = 1;
            this.showStatusBar();
            break;
          case '\x1bOR':  // F3 - Green
            this.currentFg = 2;
            this.showStatusBar();
            break;
          case '\x1bOS':  // F4 - Yellow
            this.currentFg = 3;
            this.showStatusBar();
            break;
          case '\x1b[15~':  // F5 - Blue
            this.currentFg = 4;
            this.showStatusBar();
            break;
          case '\x1b[17~':  // F6 - Magenta
            this.currentFg = 5;
            this.showStatusBar();
            break;
          case '\x1b[18~':  // F7 - Cyan
            this.currentFg = 6;
            this.showStatusBar();
            break;
          case '\x1b[19~':  // F8 - White
            this.currentFg = 7;
            this.showStatusBar();
            break;

          // Space - draw
          case ' ':
            if (this.currentTool === 'draw') {
              this.drawCell(this.cursorX, this.cursorY);
              this.refresh();
            }
            break;

          // Enter - tool actions
          case '\r':
          case '\n':
            switch (this.currentTool) {
              case 'line':
                if (!this.lineStart) {
                  this.lineStart = { x: this.cursorX, y: this.cursorY };
                } else {
                  this.drawLine(this.lineStart.x, this.lineStart.y, this.cursorX, this.cursorY);
                  this.lineStart = null;
                  this.refresh();
                }
                break;
              case 'box':
                if (!this.lineStart) {
                  this.lineStart = { x: this.cursorX, y: this.cursorY };
                } else {
                  this.drawBox(this.lineStart.x, this.lineStart.y, this.cursorX, this.cursorY);
                  this.lineStart = null;
                  this.refresh();
                }
                break;
              case 'text':
                this.textMode = true;
                this.textBuffer = '';
                break;
              case 'fill':
                this.floodFill(this.cursorX, this.cursorY);
                this.refresh();
                break;
              case 'pick':
                this.pickCell(this.cursorX, this.cursorY);
                this.refresh();
                break;
            }
            break;

          // Tab - cycle tools
          case '\t':
            const tools: Tool[] = ['draw', 'line', 'box', 'text', 'fill', 'pick'];
            const idx = tools.indexOf(this.currentTool);
            this.currentTool = tools[(idx + 1) % tools.length];
            this.lineStart = null;
            this.refresh();
            break;

          // S - save
          case 's':
          case 'S':
            await this.saveFile();
            this.refresh();
            break;

          // L - load
          case 'l':
          case 'L':
            await this.loadFile();
            this.refresh();
            break;

          // Q - quit
          case 'q':
          case 'Q':
            if (this.modified) {
              this.emit('\r\n\r\nFile modified. Save before quitting? (Y/N): ');
              const response = await this.getInput();
              if (response.toLowerCase() === 'y') {
                await this.saveFile();
              }
            }

            if (this.doorSession.bbsSession) {
              this.doorSession.bbsSession.doorInputHandler = null;
            }
            this.clearScreen();
            resolve();
            break;
        }
      };

      // Register input handler on BBS session
      if (this.doorSession.bbsSession) {
        this.doorSession.bbsSession.doorInputHandler = handler;
      }
    });
  }
}

export async function runDoor(session: DoorSession) {
  const editor = new ANSIEditor(session);
  await editor.run();
}

export default runDoor;
