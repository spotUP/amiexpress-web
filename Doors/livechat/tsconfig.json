{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node"
  },
  "include": ["*.ts", "commands/**/*.ts", "core/**/*.ts", "features/**/*.ts", "handlers/**/*.ts", "overlays/**/*.ts", "services/**/*.ts", "ui/**/*.ts", "utils/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
