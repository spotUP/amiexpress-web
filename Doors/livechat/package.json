{
  "name": "@amiexpress/livechat-door",
  "version": "3.2.0",
  "description": "Advanced multi-user chat with channels, DMs, real-time typing, and audio",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "runtime": "hybrid",
  "client": {
    "entry": "./client.ts",
    "bundle": "./dist/client.bundle.js"
  },
  "server": {
    "entry": "./index.ts"
  },
  "scripts": {
    "build": "tsc && npm run bundle:client",
    "bundle:client": "esbuild client.ts --bundle --outfile=dist/client.bundle.js --format=iife --platform=browser --target=es2020 --minify --external:fs --external:path --external:net --external:child_process --external:crypto",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "doorMetadata": {
    "name": "LiveChat",
    "command": "LIVECHAT",
    "aliases": ["CHAT", "IRC"],
    "description": "Multi-user chat with channels, real-time typing, and audio",
    "author": "AmiExpress Team",
    "minSecLevel": 10,
    "category": "Communication"
  },
  "dependencies": {
    "@amiexpress/bbs-door-sdk": "file:../../sdk"
  },
  "devDependencies": {
    "esbuild": "^0.19.0",
    "typescript": "^5.0.0"
  }
}
