{
  "name": "@amiexpress/grandmaster",
  "version": "1.0.0",
  "description": "GRANDMASTER - TGM3-Inspired Multiplayer Tetris for BBS",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "runtime": "hybrid",
  "client": {
    "entry": "./client.ts",
    "bundle": "./dist/client.bundle.js"
  },
  "server": {
    "entry": "./index.ts"
  },
  "scripts": {
    "build": "tsc && npm run copy-assets && npm run bundle:client",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "copy-assets": "mkdir -p dist/server/database && cp server/database/schema.sql dist/server/database/",
    "bundle:client": "esbuild client.ts --bundle --outfile=dist/client.bundle.js --format=iife --platform=browser --target=es2020 --minify --external:fs --external:path --external:net --external:child_process --external:crypto"
  },
  "keywords": [
    "tetris",
    "tgm3",
    "bbs",
    "door",
    "multiplayer",
    "grandmaster"
  ],
  "author": "AmiExpress",
  "license": "MIT",
  "dependencies": {
    "@amiexpress/bbs-door-sdk": "file:../../sdk",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^10.1.0",
    "tone": "^15.0.4"
  },
  "devDependencies": {
    "esbuild": "^0.19.0",
    "typescript": "^5.3.0"
  },
  "door": {
    "name": "GRANDMASTER",
    "command": "GMASTER",
    "aliases": [
      "GRANDMASTER",
      "TETRIS",
      "TGM"
    ],
    "description": "TGM3-inspired multiplayer Tetris with 20G gravity, full grading system, and real-time versus modes",
    "category": "Games",
    "minPlayers": 1,
    "maxPlayers": 64,
    "version": "1.0.0",
    "runtime": "hybrid"
  }
}
