{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "moduleResolution": "node"
  },
  "include": [
    "*.ts",
    "core/**/*.ts",
    "modes/**/*.ts",
    "network/**/*.ts",
    "ui/**/*.ts",
    "input/**/*.ts",
    "audio/**/*.ts",
    "data/**/*.ts",
    "effects/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
