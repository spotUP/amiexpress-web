{
  "name": "galaga",
  "version": "1.0.0",
  "description": "Galaga arcade game - 1981 Namco classic space shooter",
  "main": "dist/index.js",
  "bbsCommand": "GALAGA",
  "doorType": "TS",
  "runtime": "hybrid",
  "client": {
    "entry": "./client.ts",
    "bundle": "./dist/client.bundle.js"
  },
  "server": {
    "entry": "./index.ts"
  },
  "accessLevel": 0,
  "author": "AmiExpress BBS",
  "scripts": {
    "build": "tsc && npm run bundle:client",
    "bundle:client": "esbuild client.ts --bundle --outfile=dist/client.bundle.js --format=esm --target=es2020 --platform=browser --external:fs --external:path --external:child_process",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "@amiexpress/bbs-door-sdk": "file:../../sdk"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.19.0",
    "typescript": "^5.2.2"
  }
}
