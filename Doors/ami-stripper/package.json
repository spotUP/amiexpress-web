{
  "name": "ami-stripper",
  "version": "1.0.0",
  "description": "Interactive Amiga archive ad-stripper door",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@amiexpress/bbs-door-sdk": "file:../../sdk"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  },
  "amiexpress": {
    "doorName": "AmiStripper",
