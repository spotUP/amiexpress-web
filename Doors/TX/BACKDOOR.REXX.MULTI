    close('appendfile')
  End
End
   Y=1 
 End
 If Answer = "1" then
  Do
    showfile "Doors:TX/1.txt"
    HK;response = upper(trim(result))
    if response = "X" then tr "No-Save"
    if response = "	" then tr " "
    if response = "" then ss ""
do n = 0 to 8
if exists("BBS:Node"n"/Callerslog") then
  Do
    Open('appendfile',"BBS:Node"n"/Callerslog",'A')
    WriteLN('appendfile'," "HACKER" Looked at SYSOP Stats from NODE"node": at "time('C')" on "date()"")
    close('appendfile')
  End
End
    Y=1  
 End
if count = 4 then
 do
  showfile "Doors:TX/hate.txt"
  shutdown
  exit
 end
END
if Y=0 then
  Do
do n = 0 to 8
if exists("BBS:Node"n"/Callerslog") then
