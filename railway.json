{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd web/backend && npm install && cd ../frontend && npm install && npm run build"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "cd web/backend && npm start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "healthcheck": {
    "path": "/",
    "timeout": 100
  }
}
