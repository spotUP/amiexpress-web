# Makefile for Amiga GCC C Door
# Uses Bartman's m68k-amiga-elf-gcc cross-compiler

# Compiler settings
CC = m68k-amiga-elf-gcc
AS = m68k-amiga-elf-as
LD = m68k-amiga-elf-ld

# Amiga-specific flags
CFLAGS = -m68000 -O2 -fomit-frame-pointer -nostdlib -nostdinc
CFLAGS += -I../../includes -D__AMIGA_CROSS__
LDFLAGS =

# Source files
SRC = amiga-gcc-test.c
GLUE = ../../src/glue-amiga.c
OBJ = $(SRC:.c=.o) glue-amiga.o

# Output
TARGET = amiga-gcc-door

.PHONY: all clean

all: $(TARGET)

$(TARGET): $(OBJ)
	$(LD) $(LDFLAGS) -o $@ $^

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

glue-amiga.o: $(GLUE)
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -f $(OBJ) $(TARGET)

# Show build info
info:
	@echo "Building with: $(CC)"
	@echo "Target: $(TARGET)"
	@echo "Source: $(SRC)"
	@echo "Glue: $(GLUE)"