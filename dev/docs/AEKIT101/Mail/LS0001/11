you gotta include the
#include<wrokbench/workbench.h>

then use
FindToolType()
to get the data into a string then use atoi() function to convert it into
an integer...and example of code would be....
int IntFromIcon(char *s,char *c)
{
  struct DiskObject *dobj;
  char temp[100];
  char **oldtooltypes;
  char *t;
  int num;
  strcpy(temp,s);
  if(temp[strlen(temp)-1]=='/') temp[strlen(temp)-1]='\0';
  dobj=GetDiskObject(temp);
  if(dobj==NULL) return(0);
  oldtooltypes=dobj->do_ToolTypes;
  if(t=FindToolType(oldtooltypes,c))
  {
    strcpy(temp,t);
    num=atoi(t);
    FreeDiskObject(dobj);
    return(num);
  }
  FreeDiskObject(dobj);
  return(0);
}

Where s is the name of the icon, and t is the tooltype

