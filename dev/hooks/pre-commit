#!/bin/bash
#
# Pre-commit hook to enforce file size limits
# Prevents commits of files exceeding 2000 lines (with documented exemptions)
#

# ANSI color codes
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

# Allow bypass via environment variable
if [ "$SKIP_SIZE_CHECK" = "1" ]; then
    echo -e "${YELLOW}[SKIP]${NC} File size check bypassed via SKIP_SIZE_CHECK=1"
    exit 0
fi

# Maximum lines allowed (configurable)
MAX_LINES=2000

# Files that are exempt from the limit (with justification)
EXEMPT_FILES=(
    # AmigaOS API Emulation - Complex system call implementations
    "web/backend/src/amiga-emulation/api/DosLibrary.ts"           # AmigaDOS API (100+ system calls)
    "web/backend/src/amiga-emulation/api/ExecLibrary.ts"          # Exec.library API (80+ system calls)
    "web/backend/src/amiga-emulation/api/LibraryTraps.ts"         # Library trap table (LVO offsets)

    # CPU Emulation - Generated/third-party code
    "web/backend/src/amiga-emulation/cpu/moira-source/Runner/Bartman/dasm.ts"  # MOIRA disassembler

    # Door Message Handler - XIM protocol implementation
    "web/backend/src/amiga-emulation/session/DoorMessageHandler.ts"  # XIM protocol (100+ message types)

    # AREXX Interpreter - Complete language implementation
    "web/backend/src/services/arexx.service.ts"                   # AREXX interpreter (40+ BBS functions)

    # Legacy files being replaced
    "web/backend/src/database.ts"                                 # Being replaced by repositories

    # Core handlers (require express.e verification before splitting)
    "web/backend/src/handlers/command.handler.ts"                 # Core BBS routing (express.e verification required)
    "web/backend/src/handlers/door.handler.ts"                    # Door execution engine (express.e verification required)
    "web/backend/src/handlers/screen.handler.ts"                  # Screen rendering (express.e verification required)

    # Blessed UI SDK - pre-existing size, already over the cap before the
    # 2026-08-24 focus-visibility fix; splitting these is a real refactor,
    # not something to fold into an unrelated bug fix.
    "sdk/engines/ui/blessed/core/element.ts"                      # Base focusable-widget class (3500+ lines)
    "sdk/engines/ui/blessed/widgets/multiplayer-lobby.ts"         # Multi-mode lobby widget (2600+ lines)
    "sdk/engines/ui/blessed/core/screen.ts"                       # Screen buffer + render/diff engine (2700+ lines)

    # Door entry points that were already over the cap before being touched;
    # splitting them is a real refactor, not something to fold into a bug fix.
    "Doors/grandmaster/app.ts"                                    # Grandmaster door entry point (2700+ lines)
    "Doors/livechat/server.ts"                                    # LiveChat door entry point (2700+ lines)

    # Also already over the cap before being touched (2026-08-25, restored
    # panel geometry / new-user time limit). Same reasoning as above.
    "sdk/engines/ui/blessed/widgets/dockable-panel.ts"            # Dockable panel widget (2900+ lines)
    "web/backend/src/api/config-routes.ts"                        # Sysop config API surface (2000+ lines)
)

# Convert array to grep pattern
EXEMPT_PATTERN=$(printf "|%s" "${EXEMPT_FILES[@]}")
EXEMPT_PATTERN=${EXEMPT_PATTERN:1}  # Remove leading |

# ─── TypeScript doors: auto-rebuild dist/ ────────────────────────────────────
# Doors in Doors/{name}/ run dist/index.js, not TypeScript source.
# If any .ts source file in a door directory is staged but the corresponding
# dist/ is stale (not staged), rebuild now and stage the result automatically.
# This prevents the "deployed source change that never ran" class of bug.

DOOR_TS_STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^Doors/[^/]+/.*\.ts$' | grep -v '/dist/' | grep -v '/node_modules/')

if [ -n "$DOOR_TS_STAGED" ]; then
    # Collect unique door directories that have staged .ts changes
    # Doors/<name> - the first two path components, nothing else. This used
    # to strip the filename TWICE, which is right for a nested file
    # (Doors/livechat/ui/chat-log.ts -> Doors/livechat) and wrong for one at
    # the door root (Doors/arkanoid/client.ts -> Doors), where it silently
    # found no package.json and skipped the rebuild. That shipped a stale
    # Arkanoid bundle while Grandmaster rebuilt fine.
    DOOR_DIRS=$(echo "$DOOR_TS_STAGED" | cut -d/ -f1,2 | sort -u)
    for DOOR_DIR in $DOOR_DIRS; do
        PKG="$DOOR_DIR/package.json"
        if [ ! -f "$PKG" ]; then continue; fi
        BUILD_SCRIPT=$(node -e "try{const p=require('./$PKG');console.log(p.scripts&&p.scripts.build?'yes':'no')}catch(e){console.log('no')}" 2>/dev/null)
        if [ "$BUILD_SCRIPT" != "yes" ]; then continue; fi
        echo -e "${YELLOW}[Build]${NC} Rebuilding $DOOR_DIR/dist/ (TypeScript source changed)..."
        (cd "$DOOR_DIR" && npm run build 2>&1)
        if [ $? -ne 0 ]; then
            echo -e "${RED}[ERROR]${NC} Build failed for $DOOR_DIR — fix TypeScript errors before committing"
            exit 1
        fi
        git add "$DOOR_DIR/dist/"
        echo -e "${GREEN}[OK]${NC} $DOOR_DIR/dist/ rebuilt and staged"
    done
fi

echo "[Pre-commit] Checking file sizes..."

# Get all staged TypeScript files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.ts$')

if [ -z "$STAGED_FILES" ]; then
    echo -e "${GREEN}[OK]${NC} No TypeScript files to check"
    exit 0
fi

VIOLATIONS=()
WARNINGS=()

for FILE in $STAGED_FILES; do
    # Skip if file doesn't exist (deleted files)
    if [ ! -f "$FILE" ]; then
        continue
    fi

    # Skip node_modules
    if [[ "$FILE" == *"node_modules"* ]]; then
        continue
    fi

    # Check if file is exempt
    if echo "$FILE" | grep -qE "$EXEMPT_PATTERN"; then
        LINES=$(wc -l < "$FILE" | tr -d ' ')
        echo -e "${YELLOW}[EXEMPT]${NC} $FILE ($LINES lines) - Documented exemption"
        continue
    fi

    # Count lines
    LINES=$(wc -l < "$FILE" | tr -d ' ')

    if [ "$LINES" -gt "$MAX_LINES" ]; then
        VIOLATIONS+=("$FILE ($LINES lines)")
    elif [ "$LINES" -gt 1500 ]; then
        WARNINGS+=("$FILE ($LINES lines)")
    fi
done

# Print warnings (informational only)
if [ ${#WARNINGS[@]} -gt 0 ]; then
    echo ""
    echo -e "${YELLOW}[WARNING]${NC} Files approaching size limit (>1500 lines):"
    for WARNING in "${WARNINGS[@]}"; do
        echo -e "  ${YELLOW}→${NC} $WARNING"
    done
    echo ""
    echo "Consider refactoring these files before they exceed $MAX_LINES lines."
fi

# Print violations and block commit
if [ ${#VIOLATIONS[@]} -gt 0 ]; then
    echo ""
    echo -e "${RED}[ERROR]${NC} Commit blocked: Files exceed $MAX_LINES line limit:"
    echo ""
    for VIOLATION in "${VIOLATIONS[@]}"; do
        echo -e "  ${RED}✗${NC} $VIOLATION"
    done
    echo ""
    echo "Please refactor these files to stay under $MAX_LINES lines."
    echo ""
    echo "Guidelines:"
    echo "  1. Split into feature-based modules"
    echo "  2. Extract reusable functions to utils/"
    echo "  3. Move complex logic to services/"
    echo "  4. Use dependency injection for shared code"
    echo ""
    echo "To bypass (NOT RECOMMENDED): SKIP_SIZE_CHECK=1 git commit"
    echo ""
    echo "To request exemption: Update this hook with justification"
    echo ""
    exit 1
fi

echo -e "${GREEN}[OK]${NC} All files within size limits"
exit 0
