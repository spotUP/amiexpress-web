# Dependencies
node_modules
npm-debug.log
yarn-error.log
package-lock.json

# Build outputs (exclude from Docker context to reduce size)
# But keep Doors/**/dist - TypeScript doors need their built code!
dist
!Doors/**/dist
!doors/**/dist
build
.next
out

# Development
.git
.gitignore
.env.local
.env.development
.env.test
*.log

# IDE
.vscode
.idea
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Test
coverage
.nyc_output
*.test.ts
*.spec.ts
__tests__
__mocks__

# Documentation (build-time not needed)
Documentation
README.md
*.md

# Dev scripts
dev/scripts
.github

# Temporary files
tmp
temp
*.tmp

# Database (will be in volume)
db/*.db
db/*.sqlite
db/*.sqlite3

# Logs (will be in volume)
logs/*.log

# Large binary files (will be in volume)
# BUT keep AROS ROM files needed for 68K door emulation
data/amiga-roms/*
!data/amiga-roms/.gitkeep
!data/amiga-roms/aros-rom.bin
!data/amiga-roms/aros-ext.bin

# Door binaries (Render build needs them in context)
!Doors/**
!doors/**
# But exclude node_modules inside doors (they get npm ci'd fresh)
Doors/**/node_modules
doors/**/node_modules

# User data (will be in volume)
Users/*.db
Users/*.dat

# Node files (generated)
# Note: Node1-3 are needed for new user questionnaire scripts
Node0
Node4
Node5

# Batch files (generated)
batch*

# Development tools
.eslintrc
.prettierrc
jest.config.js
