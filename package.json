{
  "scripts": {
    "dev:doors": "npx ts-node -P dev/scripts/tsconfig.json dev/scripts/watch-doors.ts",
    "door:doctor": "npx ts-node -P dev/scripts/tsconfig.json dev/scripts/door-doctor.ts",
    "door:create": "npx ts-node -P dev/scripts/tsconfig.json dev/scripts/create-door-skeleton.ts",
    "door:doctor:strict": "DOCTOR_RUN=1 DOCTOR_COMPILE_PY=1 npx ts-node -P dev/scripts/tsconfig.json dev/scripts/door-doctor.ts",
    "door:harness": "npx ts-node -P dev/scripts/tsconfig.json dev/scripts/run-door-harness.ts",
    "door:ci": "npx ts-node -P dev/scripts/tsconfig.json dev/scripts/sync-fixture-doors.ts && npm run door:doctor:strict && npm run door:harness -- py-hello && npm run door:harness -- rexx-hello",
    "xim:view": "npx tsx dev/scripts/xim-viewer.ts",
    "xim:decode": "npx tsx dev/scripts/xim-decode.ts",
    "xim:live": "npx tsx dev/scripts/xim-viewer.ts --live",
    "xim:errors": "npx tsx dev/scripts/xim-viewer.ts --errors"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "chokidar": "^3.6.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
