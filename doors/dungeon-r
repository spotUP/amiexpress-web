/**
 * Simple Dungeon RPG - Text-based adventure game
 * Fixed version with proper input handling to prevent crashes
 */

interface DoorSession {
  socket: any;
  user: any;
  bbsSession: any;
  bbs?: any;
  params?: string[];
}

/**
 * Simple text-based dungeon crawler
 */
class SimpleDungeon {
  private socket: any;
  private user: any;
  private bbsSession: any;
  
  // Game state
  private player = {
    hp: 20,
    maxHp: 20,
    gold: 0,
    level: 1,
    x: 0,
    y: 0
  };
  
  private gameOver = false;
  private currentRoom = 0;
  
  constructor(socket: any, user: any, bbsSession: any) {
    this.socket = socket;
    this.user = user;
    this.bbsSession = bbsSession;
  }
  
  emit(data: string): void {
    this.socket.emit('ansi-output', data);
  }
  
  async getInput(prompt?: string): Promise<string> {
    if (prompt) this.emit(prompt);
    return new Promise((resolve) => {
      const handler = (data: string) => {
        resolve(data.trim());
      };
      this.socket.on('key-input', handler);
      this.socket.once('key-input', handler);
    });
  }
  
  async sleep(ms: number): Promise<void> {
    return new Promise(resolve => setTimeout(resolve, ms));
  }
  
  /**
   * Display player status
   */
  private displayStatus(): void {
    this.emit(`\x1b[32mHP:\x1b[0m ${this.player.hp}/${this.player.maxHp}  `);
    this.emit(`\x1b[33mGold:\x1b[0m ${this.player.gold}  `);
    this.emit(`\x1b[36mLevel:\x1b[0m ${this.player.level}\r\n`);
  }
  
  /**
   * Display current room
   */
  private displayRoom(): void {
    this.emit('\r\n');
    this.displayStatus();
    this.emit('\r\n');
    
    const rooms = [
      { name: 'Entrance Hall', desc: 'A dusty entrance to the dungeon. Passages lead north and east.' },
      { name: 'Guard Room', desc: 'An old guard post. You see weapons on the wall.' },
      { name: 'Treasure Chamber', desc: 'Glittering treasures lie scattered around.' },
      { name: 'Monster Lair', desc: 'A fearsome monster blocks your path!' },
      { name: 'Exit', desc: 'Fresh air and daylight ahead!' }
    ];
    
    const room = rooms[this.currentRoom] || rooms[0];
    this.emit(`\x1b[36m=== ${room.name} ===\x1b[0m\r\n`);
    this.emit(`${room.desc}\r\n`);
  }
  
  /**
   * Handle combat
   */
  private async combat(): Promise<boolean> {
    this.emit('\x1b[31m*** COMBAT! ***\x1b[0m\r\n');
    this.emit('A goblin attacks!\r\n');
    
    let enemyHp = 10;
    
    while (enemyHp > 0 && this.player.hp > 0) {
      this.displayStatus();
      this.emit(`\x1b[31mGoblin HP: ${enemyHp}\x1b[0m\r\n`);
      
      const choice = await this.getInput('Fight or Run (F/R): ');
      
      if (choice.toLowerCase() === 'f' || choice.toLowerCase() === 'fight') {
        // Attack
        const damage = Math.floor(Math.random() * 8) + 3;
        enemyHp -= damage;
        this.emit(`\x1b[32mYou strike for ${damage} damage!\x1b[0m\r\n`);
        
        if (enemyHp <= 0) {
          this.emit('\x1b[32mThe goblin is defeated!\x1b[0m\r\n');
          const gold = Math.floor(Math.random() * 20) + 10;
          this.player.gold += gold;
          this.emit(`You found ${gold} gold pieces!\r\n`);
          await this.sleep(1500);
          return true; // Victory
        }
        
        // Enemy counter-attack
        const enemyDamage = Math.floor(Math.random() * 5) + 2;
        this.player.hp -= enemyDamage;
        this.emit(`\x1b[31mGoblin hits you for ${enemyDamage} damage!\x1b[0m\r\n`);
        await this.sleep(1000);
        
      } else if (choice.toLowerCase() === 'r' || choice.toLowerCase() === 'run') {
        // Escape attempt
        if (Math.random() < 0.7) {
          this.emit('\x1b[33mYou escaped successfully!\x1b[0m\r\n');
          await this.sleep(1000);
          return false; // Escaped
        } else {
          this.emit('\x1b[31mFailed to escape!\x1b[0m\r\n');
          const enemyDamage = Math.floor(Math.random() * 7) + 3;
          this.player.hp -= enemyDamage;
          this.emit(`\x1b[31mGoblin catches you for ${enemyDamage} damage!\x1b[0m\r\n`);
          await this.sleep(1000);
        }
      } else {
        this.emit('\x1b[31mInvalid choice! Choose F or R.\x1b[0m\r\n');
        continue;
      }
    }
    
    if (this.player.hp <= 0) {
      return false; // Player died
    }
    
    return true;
  }
  
  /**
   * Handle room interactions
   */
  private async handleRoom(): Promise<boolean> {
    this.displayRoom();
    
    switch (this.currentRoom) {
      case 0: // Entrance
        this.emit('\x1b[33mAvailable directions:\x1b[0m N)orth, E)ast, Q)uit\r\n');
        break;
      case 1: // Guard Room
        this.emit('You find a healing potion!\r\n');
        this.player.hp = Math.min(this.player.maxHp, this.player.hp + 10);
        this.emit(`\x1b[32mYour HP is restored to ${this.player.hp}!\x1b[0m\r\n`);
        this.emit('\x1b[33mAvailable directions:\x1b[0m S)outh, E)ast, Q)uit\r\n');
        break;
      case 2: // Treasure Room
        this.emit('You find a treasure chest!\r\n');
        const treasure = Math.floor(Math.random() * 50) + 25;
        this.player.gold += treasure;
        this.emit(`\x1b[33mYou gain ${treasure} gold pieces!\x1b[0m\r\n`);
        this.emit('\x1b[33mAvailable directions:\x1b[0m W)est, E)ast, Q)uit\r\n');
        break;
      case 3: // Monster Room
        this.emit('\r\n');
        const combatResult = await this.combat();
        if (!combatResult) {
          if (this.player.hp <= 0) {
            return false; // Game over
          }
          this.emit('\x1b[33mYou retreat to the entrance.\x1b[0m\r\n');
          this.currentRoom = 0;
          await this.sleep(1500);
        } else {
          this.emit('\x1b[33mAvailable directions:\x1b[0m W)est, N)orth, Q)uit\r\n');
        }
        return true;
      case 4: // Exit
        this.emit('\r\n');
        this.emit('\x1b[32m*** VICTORY! ***\x1b[0m\r\n');
        this.emit('You have successfully explored the dungeon!\r\n');
        this.emit(`Final Gold: ${this.player.gold} pieces\r\n`);
        await this.sleep(3000);
        this.gameOver = true;
        return false;
    }
    
    return true; // Continue game
  }
  
  /**
   * Get player direction input
   */
  private async getDirection(): Promise<string> {
    return await this.getInput('Choose direction: ');
  }
  
  /**
   * Move to new room
   */
  private move(direction: string): void {
    const dir = direction.toLowerCase();
    
    switch (this.currentRoom) {
      case 0: // Entrance
        if (dir === 'n' || dir === 'north') this.currentRoom = 3;
        else if (dir === 'e' || dir === 'east') this.currentRoom = 1;
        break;
      case 1: // Guard Room
        if (dir === 'w' || dir === 'west') this.currentRoom = 0;
        else if (dir === 'e' || dir === 'east') this.currentRoom = 2;
        break;
      case 2: // Treasure Room
        if (dir === 'w' || dir === 'west') this.currentRoom = 1;
        else if (dir === 'e' || dir === 'east') this.currentRoom = 4;
        break;
      case 3: // Monster Room
        if (dir === 'w' || dir === 'west') this.currentRoom = 2;
        else if (dir === 'n' || dir === 'north') this.currentRoom = 0;
        break;
    }
  }
  
  /**
   * Main game loop
   */
  async run(): Promise<void> {
    console.log('[SimpleDungeon] Starting Simple Dungeon RPG');
    
    try {
      // Set up input handler
      const inputHandler = async (key: string) => {
        if (this.gameOver || this.player.hp <= 0) {
          this.cleanup();
          return false;
        }
        
        console.log('[SimpleDungeon] Input received:', key);
        
        // Handle room logic
        if (this.currentRoom === 3) {
          // Monster room has special combat handling
          const continueGame = await this.handleRoom();
          if (!continueGame) {
            return false;
          }
        } else {
          const continueGame = await this.handleRoom();
          if (!continueGame) {
            return false;
          }
        }
        
        return true; // Continue game
      };
      
      // Register input handler
      if (this.bbsSession) {
        this.bbsSession.doorInputHandler = inputHandler;
      }
      
      // Game introduction
      this.emit('\x1b[2J\x1b[H'); // Clear screen
      this.emit('\x1b[36m=== DUNGEON ADVENTURE ===\x1b[0m\r\n');
      this.emit('\r\n');
      this.emit('Welcome to the Dungeon!\r\n');
      this.emit('Navigate through rooms, defeat monsters, and find treasure.\r\n');
      this.emit('Use N,S,E,W for directions, Q to quit.\r\n');
      this.emit('\r\n');
      this.displayStatus();
      this.emit('\x1b[32mPress ENTER to begin...\x1b[0m');
      
      // Wait for initial input
      await this.getInput();
      
      // Main game loop
      while (!this.gameOver && this.player.hp > 0) {
        // Handle current room
        if (this.currentRoom === 3) {
          // Monster room - combat handled in handleRoom
          await this.handleRoom();
        } else {
          await this.handleRoom();
          
          // Get movement direction
          const direction = await this.getDirection();
          
          if (direction.toLowerCase() === 'q' || direction.toLowerCase() === 'quit') {
            this.gameOver = true;
            break;
          }
          
          this.move(direction);
        }
        
        // Small delay between moves
        await this.sleep(300);
      }
      
      // Game over
      if (this.player.hp <= 0) {
        this.emit('\r\n');
        this.emit('\x1b[31m*** GAME OVER ***\x1b[0m\r\n');
        this.emit('You have died in the dungeon...\r\n');
        this.emit(`Final Gold: ${this.player.gold} pieces\r\n`);
      }
      
      this.emit('\r\n\x1b[32mThanks for playing! Press ENTER to exit...\x1b[0m');
      await this.getInput();
      
      console.log('[SimpleDungeon] Game completed');
      
    } catch (error) {
      console.error('[SimpleDungeon] Error during game:', error);
      this.emit(`\r\n\x1b[31mGame error: ${(error as Error).message}\x1b[0m\r\n`);
      this.emit('\x1b[32mPress ENTER to exit...\x1b[0m');
      await this.getInput();
    }
  }
  
  /**
   * Clean up resources
   */
  private cleanup(): void {
    if (this.bbsSession && this.bbsSession.doorInputHandler) {
      delete this.bbsSession.doorInputHandler;
    }
    console.log('[SimpleDungeon] Cleanup completed');
  }
}

export async function runDoor(doorSession: DoorSession): Promise<void> {
  const { socket, user, bbsSession } = doorSession;
  
  console.log('[SimpleDungeon] Starting Simple Dungeon door');
  
  try {
    const game = new SimpleDungeon(socket, user, bbsSession);
    await game.run();
    
    console.log('[SimpleDungeon] Door execution completed');
  } catch (error) {
    console.error('[SimpleDungeon] Error:', error);
    socket.emit('ansi-output', `\r\n\x1b[31mError: ${(error as Error).message}\x1b[0m\r\n`);
  }
}

export default runDoor;