.key username,filename
.bra "{"
.ket "}"
failat 21
echo ""
list >t:l file:tempuploads/{username}/#?.LHA lformat="setenv lhafile true"
list >>t:l file:tempuploads/{username}/#?.LZH lformat="setenv lzhfile true"
list >>t:l file:tempuploads/{username}/#?.ZOO lformat="setenv zoofile true"
list >>t:l file:tempuploads/{username}/#?.ARC lformat="setenv arcfile true"
list >>t:l file:tempuploads/{username}/#?.DMS lformat="setenv dmsfile true"
list >>t:l file:tempuploads/{username}/#?.ZIP lformat="setenv zipfile true"
list >>t:l file:tempuploads/{username}/#?.P#? lformat="setenv ppfile true"
list >>t:l file:tempuploads/{username}/#?.WRP lformat="setenv warpfile true"
list >>t:l file:tempuploads/{username}/#?.EXE lformat="setenv exefile true"
execute t:l
failat 21

if $lhafile eq true
	lha t {filename}
	echo ""
	echo "Stripping any bbs adverts"
	lha d {filename} #?.foo >NIL:
	lha d {filename} #?.displayme >NIL:
	lha d {filename} #?ad.txt >NIL:
	lha d {filename} #?add.txt >NIL:
	lha d {filename} #?.adv >NIL:
	lha d {filename} #?.foo >NIL:
	Copy DLGConfig:Text/Banner.displayme TO ram:t
	ECHO "                  Upload Time => " NOLINE >>ram:t/Banner.displayme
	DATE >>ram:t/Banner.displayme
	lha -2a -Qa m {filename} RAM:t/Banner.displayme >NIL:
	echo "{username} uploaded  {filename} " >>logs:upload.log
endif

if $lzhfile eq true
	lharc t {filename}
        echo ""
        echo "Stripping any bbs adverts"
	lharc d {filename} #?.foo >NIL:
	lharc d {filename} #?.displayme >NIL:
	lharc d {filename} #?ad.txt >NIL:
	lharc d {filename} #?add.txt >NIL:
	lharc d {filename} #?.adv >NIL:
	lharc d {filename} #?.foo >NIL:
	Copy DLGConfig:Text/Banner.displayme TO ram:t
	ECHO "                  Upload Time => " NOLINE >>ram:t/Banner.displayme
	DATE >>ram:t/Banner.displayme
	lha -2a -Qa m {filename} RAM:t/Banner.displayme >NIL:
        echo ""
        echo ".LZH is nice, but have you thought about using .LHA? Alot faster!"
	echo ""
	echo "{username} uploaded  {filename} " >>logs:upload.log
endif

if $arcfile eq true
	arc t {filename}
        echo ""
        echo "Stripping any bbs adverts"
	arc d {filename} #?.foo >NIL:
	arc d {filename} #?.displayme >NIL:
	arc d {filename} #?ad.txt >NIL:
	arc d {filename} #?add.txt >NIL:
	arc d {filename} #?.adv >NIL:
	arc d {filename} #?.foo >NIL:
	Copy DLGConfig:Text/Banner.displayme TO ram:t
	ECHO "                  Upload Time => " NOLINE >>ram:t/Banner.displayme
	DATE >>ram:t/Banner.displayme
	arc a {filename} RAM:t/Banner.displayme >NIL:
	Delete RAM:t/Banner.displayme >NIL:
	echo ""
	echo "{username} uploaded  {filename} " >>logs:upload.log
endif


if $zoofile eq true
	zoo -t {filename}
        echo ""
        echo "Stripping any bbs adverts"
	zoo -d {filename} #?.foo >NIL:
	zoo -d {filename} #?.displayme >NIL:
	zoo -d {filename} #?ad.txt >NIL:
	zoo -d {filename} #?add.txt >NIL:
	zoo -d {filename} #?.adv >NIL:
	zoo -d {filename} #?.foo >NIL:
	Copy DLGConfig:Text/Banner.displayme TO ram:t
	ECHO "                  Upload Time => " NOLINE >>ram:t/Banner.displayme
	DATE >>ram:t/Banner.displayme
	zoo -a {filename} RAM:t/Banner.displayme >NIL:
	Delete RAM:t/Banner.displayme >NIL:
	echo ""
	echo "{username} uploaded  {filename} " >>logs:upload.log
endif

if $zipfile eq true
	unzip -t {filename}
        echo ""
        echo "Stripping any bbs adverts"
	zip -d {filename} #?.foo >NIL:
	zip -d {filename} #?.displayme >NIL:
	zip -d {filename} #?ad.txt >NIL:
	zip -d {filename} #?add.txt >NIL:
	zip -d {filename} #?.adv >NIL:
	zip -d {filename} #?.foo >NIL:      
	Copy DLGConfig:Text/Banner.displayme TO ram:t
	ECHO "                  Upload Time => " NOLINE >>ram:t/Banner.displayme
	DATE >>ram:t/Banner.displayme
	zip -j {filename} RAM:t/Banner.displayme >NIL:
	Delete RAM:t/Banner.displayme >NIL:
	echo ""
	echo "{username} uploaded  {filename} " >>logs:upload.log
endif


if $dmsfile eq true
	DLG:MAPUS -raRA {filename}
	echo "{username} uploaded  {filename} " >>logs:upload.log
endif


Delete t:a >NIL:
Delete t:l >NIL:
unsetenv lhafile
unsetenv lzhfile
unsetenv zoofile
unsetenv arcfile
unsetenv dmsfile
unsetenv zipfile
unsetenv ppfile
unsetenv warpfile
unsetenv exefile

DLG:df DLGConfig:Text/PreDesc.txt

