Echo " "
Echo "Please wait.... installing PrO-DmScHeCk v2.1"
Echo " "
Echo " Installation script by Exodous"
Echo " "

; Check that we have Kickstart 2.04 or better (v37)
version >NIL: exec.library 37
If WARN
  Echo "Sorry, PrO-DmScHeCk needs Kickstart 2.04 or better."

Else
  ; Copy the checker (version depends on which CPU you have got)
  Echo "....." NOLINE

  CPU >NIL: CHECK 68020
  If WARN
    Copy PrO-DmScHeCk_68000 BBS:Utils/PrO-DmScHeCk QUIET
  Else
    Copy PrO-DmScHeCk BBS:Utils/PrO-DmScHeCk QUIET
  EndIf

  ; Copy the adverts to add.
  Echo "........" NOLINE
  Copy S/#? S: QUIET

  ; Copy the File checker icon.
  Echo "..............."
  Copy FCheck/DMS.info BBS:FCheck/DMS.info QUIET

  Echo " "
  Echo "PrO-DmScHeCk v2.1 has been installed"

EndIf

Wait 5
