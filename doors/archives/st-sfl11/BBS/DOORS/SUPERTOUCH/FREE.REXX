/*           sUPER-fREE-LEECH - sUPER-fREE-LEECH - sUPER-fREE-LEECH         */

parse arg node;nodeid = "AERexxControl"node;options results;tr=transmit;gu=getuser;address value nodeid;GU 131;HIP=upper(RESULT); YES = 0;TEMPL = "|||.:¦|¦:.||[40m                                                        [44m||.:¦|¦:.|||";open('JABBA','DOORS:SUPERTOUCH/FREE.CFG','R');DO PAUL = 0 TO 99;AB.PAUL  = readln('JABBA');IF LEFT(AB.PAUL,4) = "****" THEN BREAK;END;DO EARWAX = 0 TO 99;FCO.EARWAX  = readln('JABBA');IF LEFT(FCO.EARWAX,4) = "****" THEN BREAK;END;PCNF  = strip(readln('JABBA'),B,"|");NOFRE = strip(readln('JABBA'),B,"|");GRELE = strip(readln('JABBA'),B,"|");GRELL = strip(readln('JABBA'),B,"|");CFREE = strip(readln('JABBA'),B,"|");CLOSE('JABBA');TR "[4m[36m                                                                                ";TR "[44m|          |    sUPER-fREE-LEECH v1.o1 bY sUPERTOUCH oF qUARTEX!    |          |";TR TEMPL;HOP = word(HIP,2);do LOOP = 1 to 13;WRD = RIGHT(HOP,LOOP);CHA = LEFT(WRD,1);IF CHA = "/"|CHA = ":" THEN BREAK;END;WRD = RIGHT(HOP,LOOP-1);GU 126;CONF=(RESULT);LIN=OVERLAY(PCNF""CONF,TEMPL,46-((LENGTH(CONF)+LENGTH(PCNF))%2));TR LIN;DO VEGAN = 0 TO PAUL;IF ABBREV(WRD,AB.VEGAN) THEN YES = 2;END;DO VEGAN = 0 TO EARWAX;IF CONF = FCO.VEGAN THEN YES = 1;END;IF YES = 1|YES = 2 THEN CALL YES;LIN=OVERLAY(NOFRE,TEMPL,46-(LENGTH(NOFRE)%2));TR LIN;CALL EX;YES:;FNAG = GRELE||WRD||GRELL;IF YES = 2 THEN LIN=OVERLAY(FNAG,TEMPL,46-(LENGTH(FNAG)%2));ELSE LIN=OVERLAY(CFREE,TEMPL,46-(LENGTH(CFREE)%2));TR LIN;address command "C:FILENOTE "HOP" F";EX:;TR "|          |                                                        |          |[0m";SHUTDOWN;exit