/**
 * NeoBlessed UI ANSI Editor
 * Standalone implementation with all sophisticated features
 */

import { Socket } from 'socket.io';

// Import NeoBlessed for modern terminal UI
import * as blessed from 'neo-blessed';
import * as contrib from 'blessed-contrib';

interface DoorSession {
  socket: Socket;
  user: any;
  bbsSession?: any;
}

interface Cell {
  char: string;
  fg: number;
  bg: number;
}

type Tool = 'draw' | 'line' | 'box' | 'ellipse' | 'text' | 'fill' | 'pick' | 'shifter';
type BrushMode = 'half-block' | 'custom' | 'shading' | 'colorize' | 'blink' | 'replace';
type OperationMode = 'normal' | 'transparent' | 'over' | 'underneath';
type GuideType = 'none' | 'grid' | 'center' | 'rule-of-thirds';

class NeoBlessedANSIEditor {
  private socket: Socket;
  private user: any;
  private doorSession: DoorSession;
  private screen: any;

  // Canvas state
  private canvas: Cell[][] = [];
  private width = 80;
  private height = 24;
  private cursorX = 0;
  private cursorY = 0;

  // Editor state
  private currentFg = 7;  // White
  private currentBg = 0;  // Black
  private currentChar = ' ';
  private currentTool: Tool = 'draw';
  private filename: string | null = null;
  private modified = false;

  // NeoBlessed widgets
  private mainCanvas: any;
  private statusBar: any;
  private toolSelector: any;
  private colorPicker: any;

  constructor(session: DoorSession) {
    console.log('[NeoBlessed ANSI Editor] Initializing');
    this.socket = session.socket;
    this.user = session.user;
    this.doorSession = session;
    
    this.initScreen();
    this.initCanvas();
    this.initWidgets();
    this.bindEvents();
    
    console.log('[NeoBlessed ANSI Editor] Initialized successfully');
  }

  private initScreen(): void {
    this.screen = blessed.screen({
      smartCSR: true,
      title: 'NeoBlessed ANSI Editor',
      fullUnicode: true
    });
    this.screen.program.enableMouse();
  }

  private initCanvas(): void {
    for (let y = 0; y < this.height; y++) {
      this.canvas[y] = [];
      for (let x = 0; x < this.width; x++) {
        this.canvas[y][x] = { char: ' ', fg: 7, bg: 0 };
      }
    }
  }

  private initWidgets(): void {
    // Main canvas area
    this.mainCanvas = blessed.box({
      top: 0,
      left: 0,
      width: '100%',
      height: '100%-2',
      scrollable: false,
      tags: false,
      keys: true,
      vi: true,
      mouse: true,
      style: {
        fg: 'white',
        bg: 'black'
      }
    });

    // Status bar
    this.statusBar = blessed.box({
      top: '100%-2',
      left: 0,
      width: '100%',
      height: 2,
      tags: true,
      style: {
        bg: 'black',
        fg: 'white'
      }
    });

    this.screen.append(this.mainCanvas);
    this.screen.append(this.statusBar);
  }

  private bindEvents(): void {
    // Global key bindings
    this.screen.key(['escape', 'q', 'Q'], () => this.quit());
    this.screen.key(['f1'], () => this.showHelp());
    this.screen.key(['f2'], () => this.saveFile());
    this.screen.key(['f3'], () => this.loadFile());
    this.screen.key(['f4'], () => this.newFile());
    this.screen.key(['f5'], () => this.showToolSelector());
    this.screen.key(['f6'], () => this.showColorPicker('fg'));
    this.screen.key(['f7'], () => this.showColorPicker('bg'));

    // Tool selection hotkeys
    this.screen.key(['K', 'k'], () => { this.currentTool = 'draw'; this.updateStatusBar(); });
    this.screen.key(['I', 'i'], () => { this.currentTool = 'line'; this.updateStatusBar(); });
    this.screen.key(['B', 'b'], () => { this.currentTool = 'box'; this.updateStatusBar(); });
    this.screen.key(['E', 'e'], () => { this.currentTool = 'ellipse'; this.updateStatusBar(); });
    this.screen.key(['T', 't'], () => { this.currentTool = 'text'; this.updateStatusBar(); });
    this.screen.key(['P', 'p'], () => { this.currentTool = 'fill'; this.updateStatusBar(); });
    this.screen.key(['U', 'u'], () => { this.currentTool = 'pick'; this.updateStatusBar(); });
    this.screen.key(['V', 'v'], () => { this.currentTool = 'shifter'; this.updateStatusBar(); });

    // Mouse events
    this.mainCanvas.on('click', (mouse: any) => {
      if (mouse.y >= 0 && mouse.y < this.height && mouse.x >= 0 && mouse.x < this.width) {
        this.cursorX = mouse.x;
        this.cursorY = mouse.y;
        this.handleMouseClick();
      }
    });

    this.mainCanvas.on('mousedown', (mouse: any) => {
      if (mouse.button === 'left' && mouse.y >= 0 && mouse.y < this.height && mouse.x >= 0 && mouse.x < this.width) {
        this.handleMouseDown(mouse.x, mouse.y);
      }
    });

    this.mainCanvas.on('mouseup', () => {
      this.handleMouseUp();
    });

    this.mainCanvas.on('mousemove', (mouse: any) => {
      if (mouse.y >= 0 && mouse.y < this.height && mouse.x >= 0 && mouse.x < this.width) {
        this.handleMouseMove(mouse.x, mouse.y);
      }
    });

    // Character input
    this.mainCanvas.on('keypress', (ch: string, key: any) => {
      this.handleCharacterInput(ch, key);
    });
  }

  private handleMouseClick(): void {
    switch (this.currentTool) {
      case 'draw':
        this.canvas[this.cursorY][this.cursorX] = {
          char: this.currentChar,
          fg: this.currentFg,
          bg: this.currentBg
        };
        break;
      case 'pick':
        const cell = this.canvas[this.cursorY][this.cursorX];
        this.currentFg = cell.fg;
        this.currentBg = cell.bg;
        this.currentChar = cell.char;
        break;
      case 'fill':
        this.floodFill(this.cursorX, this.cursorY);
        break;
    }
    
    this.modified = true;
    this.refreshDisplay();
  }

  private handleMouseDown(x: number, y: number): void {
    // Start drawing operations
  }

  private handleMouseUp(): void {
    // Complete drawing operations
  }

  private handleMouseMove(x: number, y: number): void {
    this.cursorX = x;
    this.cursorY = y;
    
    if (this.currentTool === 'draw') {
      this.canvas[this.cursorY][this.cursorX] = {
        char: this.currentChar,
        fg: this.currentFg,
        bg: this.currentBg
      };
      this.modified = true;
      this.refreshDisplay();
    }
  }

  private handleCharacterInput(ch: string, key: any): void {
    // Handle text input
    if (this.currentTool === 'text' && ch && ch.length === 1 && ch >= ' ' && ch <= '~') {
      this.canvas[this.cursorY][this.cursorX] = {
        char: ch,
        fg: this.currentFg,
        bg: this.currentBg
      };
      this.cursorX++;
      if (this.cursorX >= this.width) {
        this.cursorX = 0;
        this.cursorY = Math.min(this.height - 1, this.cursorY + 1);
      }
      this.modified = true;
      this.updateStatusBar();
      this.refreshDisplay();
      return;
    }

    // Function keys and special controls
    if (key) {
      switch (key.full) {
        case 'up':
          this.cursorY = Math.max(0, this.cursorY - 1);
          this.refreshDisplay();
          break;
        case 'down':
          this.cursorY = Math.min(this.height - 1, this.cursorY + 1);
          this.refreshDisplay();
          break;
        case 'left':
          this.cursorX = Math.max(0, this.cursorX - 1);
          this.refreshDisplay();
          break;
        case 'right':
          this.cursorX = Math.min(this.width - 1, this.cursorX + 1);
          this.refreshDisplay();
          break;
      }
    }
  }

  private floodFill(x: number, y: number): void {
    const targetColor = this.canvas[y][x];
    const fillColor = { char: this.currentChar, fg: this.currentFg, bg: this.currentBg };
    
    if (targetColor.fg === fillColor.fg && targetColor.bg === fillColor.bg) {
      return;
    }

    const stack = [{ x, y }];
    while (stack.length > 0) {
      const { x: cx, y: cy } = stack.pop()!;
      
      if (cx < 0 || cx >= this.width || cy < 0 || cy >= this.height) continue;
      if (this.canvas[cy][cx].fg !== targetColor.fg || this.canvas[cy][cx].bg !== targetColor.bg) continue;
      
      this.canvas[cy][cx] = { ...fillColor };
      
      stack.push({ x: cx + 1, y: cy });
      stack.push({ x: cx - 1, y: cy });
      stack.push({ x: cx, y: cy + 1 });
      stack.push({ x: cx, y: cy - 1 });
    }
  }

  private showToolSelector(): void {
    if (this.toolSelector) {
      this.toolSelector.destroy();
    }

    const toolItems = [
      'Draw (K)', 'Line (I)', 'Box (B)', 'Ellipse (E)',
      'Text (T)', 'Fill (P)', 'Pick (U)', 'Shifter (V)'
    ];

    this.toolSelector = blessed.list({
      top: 'center',
      left: 'center',
      width: 40,
      height: 15,
      border: { type: 'line' },
      style: { border: { fg: 'cyan' }, bg: 'black', fg: 'white' },
      items: toolItems,
      keys: true,
      vi: true,
      mouse: true
    });

    this.toolSelector.on('select', (item: any, index: number) => {
      const tools: Tool[] = ['draw', 'line', 'box', 'ellipse', 'text', 'fill', 'pick', 'shifter'];
      this.currentTool = tools[index];
      this.toolSelector.destroy();
      this.toolSelector = null;
      this.updateStatusBar();
      this.refreshDisplay();
    });

    this.screen.append(this.toolSelector);
    this.toolSelector.focus();
    this.screen.render();
  }

  private showColorPicker(type: 'fg' | 'bg'): void {
    if (this.colorPicker) {
      this.colorPicker.destroy();
    }

    const colors = ['Black', 'Red', 'Green', 'Yellow', 'Blue', 'Magenta', 'Cyan', 'White'];
    this.colorPicker = blessed.list({
      top: 'center',
      left: 'center',
      width: 20,
      height: 12,
      border: { type: 'line' },
      style: { border: { fg: 'cyan' }, bg: 'black', fg: 'white' },
      items: colors,
      keys: true,
      vi: true,
      mouse: true
    });

    this.colorPicker.on('select', (item: any, index: number) => {
      if (type === 'fg') {
        this.currentFg = index;
      } else {
        this.currentBg = index;
      }
      this.colorPicker.destroy();
      this.colorPicker = null;
      this.updateStatusBar();
      this.refreshDisplay();
    });

    this.screen.append(this.colorPicker);
    this.colorPicker.focus();
    this.screen.render();
  }

  private showHelp(): void {
    const help = blessed.message({
      top: 'center',
      left: 'center',
      width: 60,
      height: 20,
      border: { type: 'line' },
      style: { border: { fg: 'cyan' }, bg: 'black', fg: 'white' }
    });

    this.screen.append(help);
    help.display('NeoBlessed ANSI Editor\n\n' +
      'Tools: K=Draw I=Line B=Box E=Ellipse T=Text P=Fill U=Pick V=Shifter\n' +
      'File: F2=Save F3=Load F4=New\n' +
      'Colors: F6=Foreground F7=Background\n' +
      'Mouse: Click to draw, drag to paint\n' +
      'Arrows: Move cursor\n\n' +
      'Press any key to close');
    
    this.screen.onceKey('*', () => {
      help.destroy();
      this.screen.render();
    });
  }

  private saveFile(): void {
    // Simplified save - in real implementation would save to BBS screens directory
    this.modified = false;
    this.updateStatusBar();
  }

  private loadFile(): void {
    // Simplified load - in real implementation would load from BBS screens directory
  }

  private newFile(): void {
    this.canvas = [];
    this.initCanvas();
    this.filename = null;
    this.modified = false;
    this.cursorX = 0;
    this.cursorY = 0;
    this.refreshDisplay();
  }

  private updateStatusBar(): void {
    const toolName = this.currentTool.toUpperCase().padEnd(8);
    const pos = `X:${this.cursorX.toString().padStart(2)} Y:${this.cursorY.toString().padStart(2)}`;
    const colors = `FG:${this.currentFg} BG:${this.currentBg}`;
    const char = `CH:'${this.currentChar}'`;
    const file = this.filename || 'UNSAVED';
    const mod = this.modified ? '*' : ' ';
    
    const status = `${mod}${toolName} ${pos} ${colors} ${char} [${file}]`;
    this.statusBar.setContent(status.substring(0, this.screen.width || 80));
  }

  private refreshDisplay(): void {
    // Render the canvas with cursor highlighting
    let content = '';
    for (let y = 0; y < this.height; y++) {
      for (let x = 0; x < this.width; x++) {
        const cell = this.canvas[y][x];
        if (x === this.cursorX && y === this.cursorY) {
          // Cursor position - invert colors for visibility
          content += `\x1b[0;3${cell.bg};4${cell.fg}m${cell.char}\x1b[0m`;
        } else {
          content += `\x1b[0;3${cell.fg};4${cell.bg}m${cell.char}\x1b[0m`;
        }
      }
      if (y < this.height - 1) content += '\n';
    }
    
    this.mainCanvas.setContent(content);
    this.screen.render();
  }

  private quit(): void {
    if (this.modified) {
      const confirm = blessed.question({
        top: 'center',
        left: 'center',
        width: 50,
        height: 7,
        border: { type: 'line' },
        style: { border: { fg: 'yellow' }, bg: 'black', fg: 'white' }
      });

      this.screen.append(confirm);
      confirm.ask('Save changes before quitting?', (err: any, value: string) => {
        confirm.destroy();
        if (value.toLowerCase() === 'y' || value.toLowerCase() === 'yes') {
          this.saveFile();
        }
        this.cleanup();
      });
    } else {
      this.cleanup();
    }
  }

  private cleanup(): void {
    this.screen.program.disableMouse();
    this.screen.destroy();
    if (this.doorSession.bbsSession) {
      this.doorSession.bbsSession.returnFromDoor();
    }
  }

  async run(): Promise<void> {
    console.log('[NeoBlessed ANSI Editor] Starting with NeoBlessed UI');
    
    this.updateStatusBar();
    this.refreshDisplay();
    this.mainCanvas.focus();
    
    return new Promise<void>((resolve) => {
      console.log('[NeoBlessed ANSI Editor] NeoBlessed UI active - press ESC to exit');
    });
  }
}

export async function runDoor(session: DoorSession) {
  console.log('[ANSI Editor] Starting NeoBlessed UI ANSI editor');

  try {
    const editor = new NeoBlessedANSIEditor(session);
    await editor.run();
  } catch (error) {
    console.error('[ANSI Editor] Error:', error);
    session.socket.emit('ansi-output', `\r\n\x1b[31mANSI Editor Error: ${error}\x1b[0m\r\n`);
  }
}

export default runDoor;