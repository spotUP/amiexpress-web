# AmiExpress SDK Door Preview Configuration
# Copy this file to .sdk-preview.env and configure your quick login settings

# Enable quick login feature (auto-login on BBS startup)
SDK_QUICK_LOGIN=true

# BBS login credentials
# The user must already exist in the BBS database
SDK_LOGIN_USER=sysop
SDK_LOGIN_PASS=password

# Notes:
# - Quick login will automatically:
#   1. Login as the specified user
#   2. Skip to main menu
#   3. Run the door command being previewed
#
# - The user account must exist before using quick login
# - Create .sdk-preview.env from this example file
# - .sdk-preview.env is in .gitignore (won't be committed)
#
# - Alternative: Set environment variables directly:
#   SDK_QUICK_LOGIN=true SDK_LOGIN_USER=sysop SDK_LOGIN_PASS=password npm run preview examples/hello-world
