# AmiExpress SDK Preview - Environment Variables

# SDK Preview API URL (optional)
# The base URL for SDK preview server API endpoints
# Default: '' (empty) in dev mode, http://localhost:8080 in production
# VITE_SDK_API_URL=http://localhost:8080

# SDK Preview WebSocket URL (optional)
# The WebSocket URL for SDK preview server
# Default: ws://localhost:8080 (or current window location)
# VITE_SDK_PREVIEW_WS_URL=ws://localhost:8080

# BBS Backend URL (optional)
# The URL where the AmiExpress BBS backend is running
# Default: http://localhost:3001
# VITE_BBS_BACKEND_URL=http://localhost:3001

# Production examples:
# VITE_SDK_API_URL=https://sdk-api.example.com
# VITE_SDK_PREVIEW_WS_URL=wss://preview.example.com
# VITE_BBS_BACKEND_URL=https://bbs.uprough.net
