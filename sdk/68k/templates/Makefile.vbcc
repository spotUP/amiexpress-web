# Makefile template for AmiExpress door compilation
# Uses standard C compiler for initial testing, vbcc for final builds

# Compiler selection (prioritize COMPILER variable)
COMPILER = gcc
VC := $(shell which vc 2>/dev/null)
CC ?= gcc

# Door name (derived from current directory)
TARGET ?= $(notdir $(CURDIR))

# Compiler selection (prioritize COMPILER variable)
COMPILER = gcc
VC := $(shell which vc 2>/dev/null)
CC ?= gcc

# Door name (derived from current directory)
TARGET ?= $(notdir $(CURDIR))

# Include paths
INCLUDES = -I../includes

# Build rules based on COMPILER selection
.PHONY: all clean info

ifeq ($(COMPILER),gcc)
# GCC build for development
all: $(TARGET)

$(TARGET): $(TARGET).o glue-gcc.o
	$(CC) $(TARGET).o glue-gcc.o -o $(TARGET)

$(TARGET).o: $(TARGET).c
	$(CC) $(INCLUDES) -c $(TARGET).c -o $(TARGET).o

glue-gcc.o:
	cp ../../../dev/c-doors/src/glue-gcc.c glue-gcc.c
	$(CC) $(INCLUDES) -c glue-gcc.c -o $@
	rm -f glue-gcc.c

%.o: %.c
	$(CC) $(INCLUDES) -c $< -o $@
else ifeq ($(COMPILER),vbcc)
# vbcc build for Amiga executable
$(TARGET): $(OBJECTS)
	vc +aos68k $(OBJECTS) -o $@

glue-vbcc.o:
	cp ../../../dev/c-doors/src/glue-vbcc.c glue-vbcc.c
	vc +aos68k $(INCLUDES) -c glue-vbcc.c -o $@
	rm -f glue-vbcc.c
endif
SOURCES = $(DOOR_SOURCES) $(GLUE_SOURCES)
OBJECTS = $(SOURCES:.c=.o)

# Clean build artifacts
clean:
	rm -f *.o $(TARGET)

# Show build info
info:
	@echo "Door: $(TARGET)"
	@echo "Compiler: $(COMPILER)"
	@echo "vbcc available: $(if $(VC),yes,no)"

# Phony targets
.PHONY: clean all info