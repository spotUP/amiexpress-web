/*
 * AcsStat() - Access status check
 */
int AcsStat(int bits, int opt) {
    if (!AEDoorBase) return 0;

    register int _res __asm("d0");
    register struct Library *a6 __asm("a6") = AEDoorBase;
    register int d0 __asm("d0") = 1002;  /* DT_QUERYBIT */
    static char buffer[32];

    /* Convert bits to string */
    char *p = buffer;
    int n = bits;
    char temp[32];
    int i = 0;
    do {
        temp[i++] = '0' + (n % 10);
        n /= 10;
    } while (n > 0);
    while (i > 0) *p++ = temp[--i];
    *p = '\0';

    register char *a0 __asm("a0") = buffer;

    __asm volatile (
        "jsr a6@(-48:w)"  /* SendStrCmd */
        : "=r" (_res)
        : "r" (a6), "r" (a0), "r" (d0)
        : "d1", "memory"
    );

    return _res;
}

/*
 * IsAccess() - Check access level
 */
int IsAccess(int acs) {
    return (getlevel() >= acs) ? 1 : 0;
}

