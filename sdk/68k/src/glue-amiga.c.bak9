/* ============================================================================
 * Date/Time Functions
 * ============================================================================
 */

/*
 * GetTheDate() - Get formatted date string
 */
STRPTR GetTheDate(long number) {
    static char datebuf[32];
    getuserstring(datebuf, 143);  /* DT_STAMP_LASTON */
    return datebuf;
}

/*
 * GetTheTime() - Get formatted time string
 */
STRPTR GetTheTime(long number) {
    static char timebuf[32];
    getuserstring(timebuf, 145);  /* DT_CURR_TIME */
    return timebuf;
}

/*
 * DateToString() - Convert date number to string
 */
void DateToString(ULONG number, char *s) {
    if (!s) return;
    getuserstring(s, 143);  /* DT_STAMP_LASTON */
}

/*
 * TimeToString() - Convert time number to string
 */
void TimeToString(ULONG number, char *s) {
    if (!s) return;
    getuserstring(s, 145);  /* DT_CURR_TIME */
}

/*
 * getsystime() - Get system date and time
 */
void getsystime(ULONG number, char *d, char *t) {
    if (d) getuserstring(d, 143);  /* DT_STAMP_LASTON */
    if (t) getuserstring(t, 145);  /* DT_CURR_TIME */
}

