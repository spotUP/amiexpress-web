/* ============================================================================
 * Extended User Data Functions
 * ============================================================================
 */

/*
 * getuserstring() - Get user data field as string
 *
 * LVO -108 (0xFF94) - GetDT with field_id
 */
void getuserstring(char *ostring, int field_id) {
    if (!AEDoorBase || !ostring) return;

    register char *_res __asm("d0");
    register struct Library *a6 __asm("a6") = AEDoorBase;
    register int d0 __asm("d0") = field_id;
    register char *a0 __asm("a0") = ostring;

    __asm volatile (
        "jsr a6@(-108:w)"  /* GetDT */
        : "=r" (_res)
        : "r" (a6), "r" (d0), "r" (a0)
        : "d1", "memory"
    );
}

/*
 * putuserstring() - Set user data field from string
 *
 * LVO -102 (0xFF9A) - SetDT with field_id
 */
void putuserstring(char *ostring, int field_id) {
    if (!AEDoorBase || !ostring) return;

    register struct Library *a6 __asm("a6") = AEDoorBase;
    register int d0 __asm("d0") = field_id;
    register char *a0 __asm("a0") = ostring;

    __asm volatile (
        "jsr a6@(-102:w)"  /* SetDT */
        :
        : "r" (a6), "r" (d0), "r" (a0)
        : "d0", "memory"
    );
}

/*
 * GetInfo() - Get integer info field
 *
 * LVO -108 (0xFF94) - GetDT, parse result to int
 */
int GetInfo(int cmd) {
    if (!AEDoorBase) return 0;

    register char *_res __asm("d0");
    register struct Library *a6 __asm("a6") = AEDoorBase;
    register int d0 __asm("d0") = cmd;
    register char *a0 __asm("a0") = 0;

    __asm volatile (
        "jsr a6@(-108:w)"  /* GetDT */
        : "=r" (_res)
        : "r" (a6), "r" (d0), "r" (a0)
        : "d1", "memory"
    );

    if (!_res) return 0;

    int result = 0;
    const char *p = _res;
    int negative = 0;

    if (*p == '-') {
        negative = 1;
        p++;
    }

    while (*p >= '0' && *p <= '9') {
        result = result * 10 + (*p - '0');
        p++;
    }

    return negative ? -result : result;
}

/*
 * PutInfo() - Set integer info field
 *
 * LVO -102 (0xFF9A) - SetDT
 */
void PutInfo(int data, int cmd) {
    if (!AEDoorBase) return;

    static char buffer[32];
    char *p = buffer;
    int n = data;
    int negative = 0;

    if (n < 0) {
        negative = 1;
        n = -n;
    }

    /* Convert int to string */
    char temp[32];
    int i = 0;
    do {
        temp[i++] = '0' + (n % 10);
        n /= 10;
    } while (n > 0);

    if (negative) *p++ = '-';
    while (i > 0) *p++ = temp[--i];
    *p = '\0';

    register struct Library *a6 __asm("a6") = AEDoorBase;
    register int d0 __asm("d0") = cmd;
    register char *a0 __asm("a0") = buffer;

    __asm volatile (
        "jsr a6@(-102:w)"  /* SetDT */
        :
        : "r" (a6), "r" (d0), "r" (a0)
        : "d0", "memory"
    );
}

/*
 * getspecdata() - Get special data field
 */
void getspecdata(char *ostring, char *dest, int field_id) {
    if (!ostring || !dest) return;
    getuserstring(dest, field_id);
}

