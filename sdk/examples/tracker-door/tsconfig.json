{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@amiexpress/bbs-door-sdk": ["./node_modules/@amiexpress/bbs-door-sdk/dist/index.d.ts"],
      "@amiexpress/bbs-door-sdk/*": ["./node_modules/@amiexpress/bbs-door-sdk/dist/*"],
      "@amiexpress/bbs-door-sdk/client": ["./node_modules/@amiexpress/bbs-door-sdk/dist/client/index.d.ts"],
      "@amiexpress/bbs-door-sdk/server": ["./node_modules/@amiexpress/bbs-door-sdk/dist/server/index.d.ts"],
      "@amiexpress/bbs-door-sdk/common": ["./node_modules/@amiexpress/bbs-door-sdk/dist/common/index.d.ts"]
    },
    "typeRoots": ["./node_modules/@types"],
    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "declaration": true,
    "sourceMap": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "*.ts",
    "**/*.ts",
    "types.d.ts",
    "../../core/**/*.ts",
    "../../engines/**/*.ts",
    "../../components/**/*.ts",
    "../../tools/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "../../tools/preview",
    "../../**/*.spec.ts"
  ]
}
