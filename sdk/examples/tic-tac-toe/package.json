  "keywords": [
    "bbs",
    "door",
    "game",
    "multiplayer",
    "turn-based",
    "tic-tac-toe"
  ],
  "dependencies": {
    "@amiexpress/bbs-door-sdk": "file:../../"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.2.2",
    "tsx": "^4.19.2"
  },
  "runtime": "server"
}
