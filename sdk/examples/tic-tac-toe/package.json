{
  "name": "tic-tac-toe-multiplayer",
  "version": "1.0.0",
  "description": "Turn-based multiplayer Tic-Tac-Toe demonstrating Network Engine",
  "main": "dist/index.js",
  "author": "AmiExpress SDK Team",
  "license": "MIT",
  "category": "game",
  "bbsCommand": "TICTACTOE",
  "scripts": {
    "start": "npx tsx index.ts",
    "dev": "npx tsx --watch index.ts",
    "build": "tsc",
