{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strict": true,
    "types": ["node"],
    "downlevelIteration": true,
    "baseUrl": ".",
    "paths": {
      "@amiexpress/bbs-door-sdk": ["../../dist/index.d.ts"],
      "@amiexpress/bbs-door-sdk/*": ["../../dist/*"]
    }
  },
  "include": ["*.ts"],
  "exclude": ["node_modules", "dist", "../../dist", "../../node_modules"]
}
