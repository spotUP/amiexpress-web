{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "outDir": "./dist",
    "rootDir": "./",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "typeRoots": ["./types", "./node_modules/@types"]
  },
  "include": [
    "index.ts",
    "common/**/*",
    "server/**/*",
    "client/**/*",
    "core/**/*",
    "engines/**/*",
    "components/**/*",
    "tools/**/*",
    "types/**/*",
    "utils/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "examples",
    "tools/preview/frontend",
    "tools/preview/client",
    "tools/preview/public",
    "**/*.spec.ts",
    "**/__tests__"
  ]
}
