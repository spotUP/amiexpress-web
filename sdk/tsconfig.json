{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "types": ["node", "jest"]
  },
  "include": [
    "core/**/*",
    "engines/**/*",
    "components/**/*",
    "tools/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "examples",
    "tools/preview/frontend",
    "**/*.spec.ts"
  ]
}
