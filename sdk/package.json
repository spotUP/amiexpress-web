{
  "name": "@amiexpress/bbs-door-sdk",
  "version": "2.0.0",
  "description": "Revolutionary BBS Door Development SDK - Dual Runtime (Server & Client)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "amiexpress-sdk": "./dist/tools/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./common": {
      "types": "./dist/common/index.d.ts",
      "default": "./dist/common/index.js"
    }
  },
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "copy-assets": "cp -r templates dist/ && cp package.json dist/ && cp -r examples/*/assets dist/examples/ 2>/dev/null || true",
    "dev": "tsc --watch",
    "start": "bash -c 'if ! lsof -ti:3001 > /dev/null 2>&1; then echo \"Starting BBS servers...\"; cd .. && ./dev/scripts/start-servers.sh > /dev/null 2>&1 & sleep 5; fi && cd tools/preview && lsof -ti:8080 | xargs kill -9 2>/dev/null || true && sleep 1 && node server.js'",
    "preview": "bash tools/preview/start-preview.sh --",
    "preview:quick": "node tools/preview/server.js",
    "create-door": "node dist/tools/cli/index.js create-door",
    "pack": "node dist/tools/cli/index.js pack",
    "validate": "node dist/tools/cli/index.js validate",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "docs": "typedoc --out docs/api core",
    "clean": "rm -rf dist releases",
    "prepare": "npm run build"
  },
  "keywords": [
    "bbs",
    "door",
    "game",
    "retro",
    "ansi",
    "ascii",
    "amiga",
    "telnet"
  ],
  "author": "AmiExpress Team",
  "license": "MIT",
  "dependencies": {
    "@types/blessed": "^0.1.25",
    "adm-zip": "^0.5.16",
    "archiver": "^6.0.1",
    "blessed-contrib": "^4.11.0",
    "chalk": "^4.1.2",
    "chokidar": "^3.5.3",
    "commander": "^11.0.0",
    "drawille": "^2.0.2",
    "esbuild": "^0.19.12",
    "express": "^4.18.2",
    "inquirer": "^8.2.5",
    "neo-blessed": "^0.2.0",
    "ora": "^5.4.1",
    "scribbletune": "^4.0.4",
    "tone": "^15.3.7",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.0",
    "@types/express": "^4.17.20",
    "@types/inquirer": "^8.2.10",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.24",
    "@types/ws": "^8.5.8",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typedoc": "^0.25.3",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
