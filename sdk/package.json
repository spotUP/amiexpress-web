{
  "name": "@amiexpress/bbs-door-sdk",
  "version": "2.0.0",
  "description": "Revolutionary BBS Door Development SDK - Dual Runtime (Server & Client)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "amiexpress-sdk": "./dist/tools/cli/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist-esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist-esm/client/index.js",
      "require": "./dist/client/index.js",
      "default": "./dist-esm/client/index.js"
    },
    "./common": {
      "types": "./dist/common/index.d.ts",
      "import": "./dist-esm/common/index.js",
      "require": "./dist/common/index.js",
      "default": "./dist-esm/common/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist-esm/core/index.js",
      "require": "./dist/core/index.js",
      "default": "./dist-esm/core/index.js"
    },
    "./core/types": {
      "types": "./dist/core/types.d.ts",
      "default": "./dist/core/types.js"
    },
    "./engines/graphics/braille-graphics": {
      "types": "./dist/engines/graphics/braille-graphics.d.ts",
      "default": "./dist/engines/graphics/braille-graphics.js"
    },
    "./engines/ui/blessed": {
      "types": "./dist/engines/ui/blessed/index.d.ts",
      "import": "./dist-esm/engines/ui/blessed/index.js",
      "require": "./dist/engines/ui/blessed/index.js",
      "default": "./dist/engines/ui/blessed/index.js"
    },
    "./engines/ui/blessed/contrib": {
      "types": "./dist/engines/ui/blessed/contrib/index.d.ts",
      "default": "./dist/engines/ui/blessed/contrib/index.js"
    },
    "./engines/ui/blessed/utils/animations": {
      "types": "./dist/engines/ui/blessed/utils/animations/index.d.ts",
      "default": "./dist/engines/ui/blessed/utils/animations/index.js"
    },
    "./engines/ui/ansi-editor": {
      "types": "./dist/engines/ui/ansi-editor/index.d.ts",
      "import": "./dist-esm/engines/ui/ansi-editor/index.js",
      "require": "./dist/engines/ui/ansi-editor/index.js",
      "default": "./dist/engines/ui/ansi-editor/index.js"
    },
    "./utils/blessed-helpers": {
      "types": "./dist/utils/blessed-helpers.d.ts",
      "default": "./dist/utils/blessed-helpers.js"
    },
    "./utils/DoorLoader": {
      "types": "./dist/utils/DoorLoader.d.ts",
      "default": "./dist/utils/DoorLoader.js"
    },
    "./tools/runDoorSession": {
      "types": "./dist/tools/runDoorSession.d.ts",
      "default": "./dist/tools/runDoorSession.js"
    },
    "./engines/tactical/tactical-combat-engine": {
      "types": "./dist/engines/tactical/tactical-combat-engine.d.ts",
      "default": "./dist/engines/tactical/tactical-combat-engine.js"
    },
    "./engines/audio/tracker": {
      "types": "./dist/engines/audio/tracker-engine.d.ts",
      "default": "./dist/engines/audio/tracker-engine.js"
    },
    "./engines/audio/audio-engine": {
      "types": "./dist/engines/audio/audio-engine.d.ts",
      "import": "./dist-esm/engines/audio/audio-engine.js",
      "require": "./dist/engines/audio/audio-engine.js",
      "default": "./dist/engines/audio/audio-engine.js"
    },
    "./engines/network/network-engine": {
      "types": "./dist/engines/network/network-engine.d.ts",
      "default": "./dist/engines/network/network-engine.js"
    },
    "./ncurses": {
      "types": "./dist/engines/ui/ncurses/index.d.ts",
      "default": "./dist/engines/ui/ncurses/index.js"
    }
  },
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm && npm run copy-assets",
    "build:dev": "npm run build:cjs && npm run build:esm && npm run copy-assets",
    "build:cjs": "tsc",
    "build:esm": "tsc -p tsconfig.client.json",
    "copy-assets": "cp -r templates dist/ && cp package.json dist/ && cp -r examples/*/assets dist/examples/ 2>/dev/null || true && cp engines/ui/neo-blessed.d.ts dist/engines/ui/ 2>/dev/null || true",
    "minify": "node scripts/minify.mjs",
    "dev": "tsc --watch",
    "start": "bash -c 'if ! lsof -ti:3001 > /dev/null 2>&1; then echo \"Starting BBS servers...\"; cd .. && ./dev/scripts/start-servers.sh > /dev/null 2>&1 & sleep 5; fi && cd tools/preview && lsof -ti:8080 | xargs kill -9 2>/dev/null || true && sleep 1 && node server.js'",
    "preview": "bash tools/preview/start-preview.sh --",
    "preview:quick": "node tools/preview/server.js",
    "create-door": "node dist/tools/cli/index.js create-door",
    "pack": "node dist/tools/cli/index.js pack",
    "validate": "node dist/tools/cli/index.js validate",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "docs": "typedoc --out docs/api core",
    "clean": "rm -rf dist releases",
    "prepare": "npm run build"
  },
  "keywords": [
    "bbs",
    "door",
    "game",
    "retro",
    "ansi",
    "ascii",
    "amiga",
    "telnet"
  ],
  "author": "AmiExpress Team",
  "license": "MIT",
  "dependencies": {
    "@pokertools/engine": "1.0.1",
    "@pokertools/evaluator": "1.0.1",
    "@pokertools/types": "1.0.1",
    "@unblessed/blessed": "^1.0.0-alpha.23",
    "@unblessed/browser": "^1.0.0-alpha.23",
    "@unblessed/core": "^1.0.0-alpha.23",
    "@unblessed/node": "^1.0.0-alpha.23",
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "chalk": "^4.1.2",
    "chiptune3": "^0.8.3",
    "chokidar": "^3.5.3",
    "commander": "^11.0.0",
    "drawille": "^2.0.2",
    "esbuild": "^0.19.12",
    "express": "^4.18.2",
    "inquirer": "^8.2.5",
    "multer": "^2.0.2",
    "ora": "^5.4.1",
    "scribbletune": "^4.0.4",
    "socket.io": "^4.7.0",
    "socket.io-client": "^4.8.3",
    "tone": "^15.3.7",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.27",
    "@types/express": "^4.17.20",
    "@types/inquirer": "^8.2.12",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.24",
    "@types/ws": "^8.5.8",
    "blessed": "^0.1.81",
    "jest": "^29.7.0",
    "terser": "^5.44.1",
    "ts-jest": "^29.1.1",
    "typedoc": "^0.25.3",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
