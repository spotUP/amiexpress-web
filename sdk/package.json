{
  "name": "@amiexpress/bbs-door-sdk",
  "version": "1.0.0",
  "description": "Revolutionary BBS Door Development SDK - Next-Generation Games & Tools",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "amiexpress-sdk": "./dist/cli/index.js"
  },
  "scripts": {
    "install": "npm run build",
    "build": "tsc && npm run copy-assets",
    "copy-assets": "cp -r templates dist/ && cp -r examples/*/assets dist/examples/ 2>/dev/null || true",
    "dev": "tsc --watch",
    "preview": "node tools/preview/server.js",
    "create-door": "node dist/cli/create-door.js",
    "pack": "node dist/tools/packer/index.js",
    "test": "jest",
    "docs": "typedoc --out docs/api core",
    "clean": "rm -rf dist releases"
  },
  "keywords": [
    "bbs",
    "door",
    "game",
    "retro",
    "ansi",
    "ascii",
    "amiga",
    "telnet"
  ],
  "author": "AmiExpress Team",
  "license": "MIT",
  "dependencies": {
    "tone": "^14.7.77",
    "scribbletune": "^4.4.0",
    "chalk": "^4.1.2",
    "commander": "^11.0.0",
    "archiver": "^6.0.1",
    "express": "^4.18.2",
    "ws": "^8.14.2",
    "chokidar": "^3.5.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/express": "^4.17.20",
    "@types/ws": "^8.5.8",
    "typescript": "^5.2.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typedoc": "^0.25.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
