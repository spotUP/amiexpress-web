{
  "name": "@amiexpress/bbs-door-sdk",
  "version": "1.0.0",
  "description": "Revolutionary BBS Door Development SDK - Next-Generation Games & Tools",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "amiexpress-sdk": "./dist/tools/cli/index.js"
  },
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "copy-assets": "cp -r templates dist/ && cp package.json dist/ && cp -r examples/*/assets dist/examples/ 2>/dev/null || true",
    "dev": "tsc --watch",
    "preview": "node tools/preview/server.js",
    "build-preview": "bash scripts/build-all-examples.sh",
    "create-door": "node dist/tools/cli/index.js create-door",
    "pack": "node dist/tools/cli/index.js pack",
    "validate": "node dist/tools/cli/index.js validate",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "docs": "typedoc --out docs/api core",
    "clean": "rm -rf dist releases",
    "prepare": "npm run build"
  },
  "keywords": [
    "bbs",
    "door",
    "game",
    "retro",
    "ansi",
    "ascii",
    "amiga",
    "telnet"
  ],
  "author": "AmiExpress Team",
  "license": "MIT",
  "dependencies": {
    "archiver": "^6.0.1",
    "chalk": "^4.1.2",
    "chokidar": "^3.5.3",
    "commander": "^11.0.0",
    "express": "^4.18.2",
    "inquirer": "^8.2.5",
    "ora": "^5.4.1",
    "scribbletune": "^4.0.4",
    "tone": "^14.7.77",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.0",
    "@types/express": "^4.17.20",
    "@types/inquirer": "^8.2.10",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.24",
    "@types/ws": "^8.5.8",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typedoc": "^0.25.3",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
